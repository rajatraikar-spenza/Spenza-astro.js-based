---
// CtaBanner.astro - Bottom CTA banners (Dashboard and Final CTA)
---

<section class="dashboard-cta" id="dashboard-cta">
  <div class="dashboard-inner">
    <div class="dashboard-content">
      <h2 class="dashboard-title">Run Your Whole Connectivity Business from One Dashboard</h2>
      <p class="dashboard-desc">
        Provision SIMs, track real-time usage, switch carriers, and manage billing from a single screen. No spreadsheets, no vendor logins, no surprises on the invoice.
      </p>
      <a href="https://web.spenza.com/auth/signup" class="btn btn-primary" id="dashboard-cta-btn">See It in Action</a>
    </div>
    <div class="dashboard-visual">
      <img
        src="https://spenza.com/wp-content/uploads/2026/04/dashboard-1024x514.png"
        alt="Spenza connectivity dashboard"
        loading="lazy"
        class="dashboard-img"
      />
    </div>
  </div>
</section>

<section class="final-cta" id="final-cta">
  <div class="final-cta-inner">
    <h2 class="final-cta-title">Launch Telecom Services Faster. Scale Efficiently. Operate Effortlessly.</h2>
    <p class="final-cta-desc">
      Spenza brings connectivity, billing, automation, and support into one platform, so you can grow without growing your operational load.
    </p>
    <div class="final-cta-buttons">
      <a href="#" class="btn btn-primary" id="final-demo-btn">book your demo now</a>
      <a href="https://spenza.com/contact-us/" class="btn btn-outline" id="final-chat-btn">chat with us</a>
    </div>
  </div>
</section>

<style>
  /* Dashboard CTA */
  .dashboard-cta {
    background: white;
    padding: 96px 2rem;
    border-top: 1px solid #eee;
  }

  .dashboard-inner {
    max-width: 1140px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .dashboard-title {
    font-size: clamp(1.5rem, 2.5vw, 2.25rem);
    font-weight: 800;
    color: #1a1a2e;
    line-height: 1.2;
    margin-bottom: 1rem;
  }

  .dashboard-desc {
    font-size: 1rem;
    color: #555;
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .dashboard-visual {
    display: flex;
    justify-content: center;
  }

  .dashboard-img {
    width: 100%;
    height: auto;
    border-radius: 16px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.12);
  }

  /* Final CTA */
  .final-cta {
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
    padding: 96px 2rem;
    text-align: center;
  }

  .final-cta-inner {
    max-width: 700px;
    margin: 0 auto;
  }

  .final-cta-title {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 800;
    color: white;
    line-height: 1.2;
    margin-bottom: 1rem;
  }

  .final-cta-desc {
    font-size: 1.0625rem;
    color: rgba(255, 255, 255, 0.75);
    line-height: 1.65;
    margin-bottom: 2.5rem;
  }

  .final-cta-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-block;
    padding: 14px 32px;
    border-radius: 999px;
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    transition: all 0.2s ease;
    text-transform: lowercase;
  }

  .btn-primary {
    background: #FF4500;
    color: white;
  }

  .btn-primary:hover {
    background: #e03d00;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(255, 69, 0, 0.4);
  }

  .btn-outline {
    border: 2px solid rgba(255, 255, 255, 0.4);
    color: white;
    background: transparent;
  }

  .btn-outline:hover {
    border-color: white;
    background: rgba(255, 255, 255, 0.08);
    transform: translateY(-2px);
  }

  @media (max-width: 900px) {
    .dashboard-inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .dashboard-visual {
      order: -1;
    }
  }

  @media (max-width: 480px) {
    .final-cta-buttons {
      flex-direction: column;
      align-items: center;
    }
  }
</style>
