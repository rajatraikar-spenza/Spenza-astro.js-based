---
// BlogSection.astro - Latest Telecom Industry Insights

const posts = [
  {
    category: 'eSIM',
    title: 'How to Start a Travel eSIM Business in 2026',
    date: 'July 30, 2026',
    href: 'https://spenza.com/esim/how-to-start-travel-esim-business/',
    image: 'https://spenza.com/wp-content/uploads/2026/07/How-to-Start-a-Travel-eSIM-Business-in-2026.png',
  },
  {
    category: 'Spenza Platform',
    title: 'Daito Case Study: Shared SMS 2FA with Spenza',
    date: 'July 29, 2026',
    href: 'https://spenza.com/spenza-product/daito-case-study/',
    image: 'https://spenza.com/wp-content/uploads/2026/07/How-Daito-Built-a-Shared-SMS-Inbox-for-2FA-with-Spenza.png',
  },
  {
    category: 'MVNO',
    title: 'MVNO Launch Checklist: 15 Requirements to Go Live 2026',
    date: 'July 28, 2026',
    href: 'https://spenza.com/mvno/mvno-launch-checklist/',
    image: 'https://spenza.com/wp-content/uploads/2026/07/The-MVNO-Launch-Checklist-15-Requirements-to-Go-Live-in-2026.png',
  },
  {
    category: 'Spenza Platform',
    title: 'RocketPhone Case Study: Launching an Enterprise MVNO with Spenza',
    date: 'July 17, 2026',
    href: 'https://spenza.com/spenza-product/rocketphone-case-study/',
    image: 'https://spenza.com/wp-content/uploads/2026/07/RocketPhone-Case-Study-Launching-an-AI-Powered-Business-Mobile-Network-with-Spenza.png',
  },
  {
    category: 'Telecom',
    title: 'Why AI Agents Need Real Phone Numbers, Not VoIP',
    date: 'July 17, 2026',
    href: 'https://spenza.com/telecom/why-ai-agents-need-real-phone-numbers/',
    image: 'https://spenza.com/wp-content/uploads/2026/07/Why-AI-Agents-Need-Real-Phone-Numbers-Not-VoIP.png',
  },
  {
    category: 'Telecom',
    title: "Non-VoIP vs. VoIP Numbers: What's the Difference (2026)",
    date: 'July 17, 2026',
    href: 'https://spenza.com/telecom/non-voip-vs-voip-numbers/',
    image: 'https://spenza.com/wp-content/uploads/2026/07/Non-VoIP-vs.-VoIP-Numbers-Whats-the-Difference-.png',
  },
];
---

<section class="blog-section" id="blog">
  <div class="blog-inner">
    <h2 class="blog-heading">
      Latest Telecom Industry <span class="highlight">Insights</span>
    </h2>
    <p class="blog-subheading">
      Explore insights, industry trends, and practical guides on telecom, IoT, eSIM, and connectivity.
    </p>

    <div class="blog-grid">
      {posts.map((post) => (
        <a href={post.href} class="blog-card" target="_blank" rel="noopener">
          <div class="blog-card-image">
            <img src={post.image} alt={post.title} loading="lazy" />
          </div>
          <div class="blog-card-content">
            <span class="blog-category">{post.category}</span>
            <h3 class="blog-title">{post.title}</h3>
            <div class="blog-footer">
              <span class="blog-date">{post.date}</span>
              <span class="blog-read-more">Read More</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .blog-section {
    background: white;
    padding: 96px 2rem;
  }

  .blog-inner {
    max-width: 1140px;
    margin: 0 auto;
    text-align: center;
  }

  .blog-heading {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 800;
    color: #1a1a2e;
    margin-bottom: 0.75rem;
  }

  .highlight {
    color: #FF4500;
  }

  .blog-subheading {
    font-size: 1rem;
    color: #666;
    margin-bottom: 3rem;
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem;
    text-align: left;
  }

  .blog-card {
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid #eee;
    text-decoration: none;
    display: block;
    transition: box-shadow 0.25s ease, transform 0.25s ease;
    background: white;
  }

  .blog-card:hover {
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.08);
    transform: translateY(-4px);
  }

  .blog-card-image {
    width: 100%;
    height: 180px;
    overflow: hidden;
    background: #f5f5f7;
  }

  .blog-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .blog-card:hover .blog-card-image img {
    transform: scale(1.05);
  }

  .blog-card-content {
    padding: 1.25rem;
  }

  .blog-category {
    display: inline-block;
    background: rgba(255, 69, 0, 0.1);
    color: #FF4500;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 999px;
    margin-bottom: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .blog-title {
    font-size: 0.9375rem;
    font-weight: 700;
    color: #1a1a2e;
    line-height: 1.45;
    margin-bottom: 1rem;
  }

  .blog-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .blog-date {
    font-size: 0.8125rem;
    color: #999;
  }

  .blog-read-more {
    font-size: 0.8125rem;
    font-weight: 700;
    color: #FF4500;
  }

  @media (max-width: 900px) {
    .blog-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 580px) {
    .blog-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
