---
/**
 * "The Numbers Speak for Themselves" — identical on all three hub pages.
 *
 * `.cnt` counts up from zero when the section scrolls in; see
 * `scripts/hub.js`.
 */
---

<section class="sec sec--sand">
  <div class="wrap rv">
    <div class="nums-head">
      <h2 class="h2">The Numbers <em class="s">Speak for Themselves</em></h2>
      <a class="btn btn--acc" href="https://web.spenza.com/auth/signup">Explore Platform <i>&rarr;</i></a>
    </div>
    <div class="stats">
      <div class="stat">
        <strong><sup>&lt;</sup><span class="cnt" data-to="7">7</span><sub>Days</sub></strong>
        <p>Time-to-Launch</p>
        <svg class="spark" viewBox="0 0 200 36" preserveAspectRatio="none" aria-hidden="true"><path class="area" d="M0 30 L40 28 L80 22 L120 14 L160 8 L200 4 L200 36 L0 36Z"/><path d="M0 30 L40 28 L80 22 L120 14 L160 8 L200 4"/></svg>
      </div>
      <div class="stat">
        <strong><span class="cnt" data-to="50">50</span><sup>%</sup></strong>
        <p>Reduction in fixed costs</p>
        <svg class="spark" viewBox="0 0 200 36" preserveAspectRatio="none" aria-hidden="true"><path class="area" d="M0 4 L40 8 L80 12 L120 20 L160 24 L200 30 L200 36 L0 36Z"/><path d="M0 4 L40 8 L80 12 L120 20 L160 24 L200 30"/></svg>
      </div>
      <div class="stat">
        <strong><sup>$</sup><span class="cnt" data-to="500">500</span></strong>
        <p>Saved annually per line</p>
        <svg class="spark" viewBox="0 0 200 36" preserveAspectRatio="none" aria-hidden="true"><path class="area" d="M0 32 L40 26 L80 24 L120 16 L160 12 L200 6 L200 36 L0 36Z"/><path d="M0 32 L40 26 L80 24 L120 16 L160 12 L200 6"/></svg>
      </div>
      <div class="stat">
        <strong><sup>$</sup><span class="cnt" data-to="100000">100,000</span></strong>
        <p>Saved annually on operator expense</p>
        <svg class="spark" viewBox="0 0 200 36" preserveAspectRatio="none" aria-hidden="true"><path class="area" d="M0 33 L40 30 L80 22 L120 18 L160 9 L200 3 L200 36 L0 36Z"/><path d="M0 33 L40 30 L80 22 L120 18 L160 9 L200 3"/></svg>
      </div>
    </div>
  </div>
</section>
