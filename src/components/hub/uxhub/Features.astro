---
/** UX Hub: The Only Connectivity Platform Your Customers Actually Want to Use */
---

<section class="sec" style="padding-bottom:72px">
  <div class="wrap">
    <div class="feat-head rv">
      <h2 class="h2">The Only <em class="s">Connectivity Platform</em> Your Customers Actually Want to Use</h2>
    </div>

    <!-- 01 -->
    <div class="feat rv">
      <div class="feat-copy">
        <span class="feat-num">01</span>
        <span class="feat-tag">Orchestrate Connectivity</span>
        <h3>One Dashboard for Every Operator</h3>
        <p>Manage all operator connections from a single no-code dashboard with instant network switching. Monitor failover performance in real time with complete visibility across your connectivity portfolio.</p>
      </div>
      <div class="panel" aria-hidden="true">
        <div class="panel-h"><span>uxhub / operators</span><span class="live">live</span></div>
        <svg class="graph" viewBox="0 0 560 300">
          <!-- flows in -->
          <path class="flow" d="M150 60 C 190 60, 190 118, 214 118"/>
          <path class="flow" d="M150 150 L 214 150"/>
          <path class="flow flow--mute" d="M150 240 C 190 240, 190 182, 214 182"/>
          <!-- flows out -->
          <path class="flow" d="M346 134 C 380 134, 380 100, 410 100"/>
          <path class="flow" d="M346 166 C 380 166, 380 200, 410 200"/>
          <!-- sources -->
          <g class="node"><rect x="20" y="40" width="130" height="40" rx="8"/><path class="ic" d="M36 52 v16 M32 56 a6 6 0 0 1 8 0 M29 53 a10 10 0 0 1 14 0"/><text x="52" y="65">BYON</text></g>
          <g class="node"><rect x="20" y="130" width="130" height="40" rx="8"/><path class="ic" d="M36 142 v16 M32 146 a6 6 0 0 1 8 0 M29 143 a10 10 0 0 1 14 0"/><text x="52" y="155">Operator 1</text></g>
          <g class="node"><rect x="20" y="220" width="130" height="40" rx="8"/><path class="ic" d="M36 232 v16 M32 236 a6 6 0 0 1 8 0 M29 233 a10 10 0 0 1 14 0"/><text x="52" y="245">Operator 2</text></g>
          <!-- hub -->
          <g class="hub">
            <rect class="box" x="214" y="84" width="132" height="132" rx="14"/>
            <g class="chip"><rect x="226" y="98" width="108" height="30" rx="7"/><text x="280" y="117.5" text-anchor="middle">Spenza Aggregator</text></g>
            <path d="M276 140 l8 0 l-6 9 l7 0 l-10 13 l3 -9 l-6 0 z" fill="#ff4904"/>
            <g class="chip"><rect x="226" y="172" width="108" height="30" rx="7"/><text x="280" y="191.5" text-anchor="middle">Spenza Marketplace</text></g>
          </g>
          <!-- outputs -->
          <g class="node"><rect x="410" y="80" width="130" height="40" rx="8"/><rect x="424" y="93" width="14" height="14" rx="3" fill="none" stroke="#ff4904" stroke-width="1.4"/><text x="446" y="105">Custom Plan 1</text></g>
          <g class="node"><rect x="410" y="180" width="130" height="40" rx="8"/><rect x="424" y="193" width="14" height="14" rx="3" fill="none" stroke="#ff4904" stroke-width="1.4"/><text x="446" y="205">Custom Plan 2</text></g>
          <text class="lbl" x="20" y="24">NETWORKS</text>
          <text class="lbl" x="214" y="72">SPENZA</text>
          <text class="lbl" x="410" y="64">YOUR PLANS</text>
          <circle class="dot" cx="214" cy="150" r="3.5"/><circle class="dot" cx="410" cy="100" r="3.5"/><circle class="dot" cx="410" cy="200" r="3.5"/>
        </svg>
        <div class="fo">
          <small>FAILOVER &middot; 24H</small>
          <div class="fo-cells"><i class="a"></i><i class="a"></i><i class="a"></i><i class="a"></i><i class="a"></i><i class="a"></i><i class="a"></i><i class="b"></i><i class="a"></i><i class="a"></i><i class="a"></i><i class="a"></i><i class="a"></i><i class="a"></i><i class="a"></i><i class="a"></i><i class="b"></i><i class="a"></i><i class="a"></i><i class="a"></i><i class="a"></i><i class="a"></i><i class="a"></i><i class="a"></i></div>
          <span class="toggle">auto-switch <b></b></span>
        </div>
      </div>
    </div>

    <!-- 02 -->
    <div class="feat feat--flip rv">
      <div class="feat-copy">
        <span class="feat-num">02</span>
        <span class="feat-tag">Deliver Custom Experiences</span>
        <h3>Brand It Your Way</h3>
        <p>Fully customize your subscriber portal with your brand identity, including logos, colors, content, and workflows. Create a seamless customer experience by owning every touchpoint across the subscriber journey.</p>
      </div>
      <div class="panel" id="studio" data-logo="ring">
        <div class="panel-h"><span>uxhub / brand studio</span><span class="mono" style="color:var(--acctext)">preview</span></div>
        <div class="studio">
          <div class="ctrl">
            <div class="ctrl-g"><small>LOGO</small>
              <div class="logos" role="group" aria-label="Preview logo">
                <button type="button" class="logo-opt" aria-pressed="true" data-logo="ring"><i class="lg lg--ring"><svg class="g-ring" viewBox="0 0 24 24"><path d="M12 6.5a5.5 5.5 0 1 0 5.5 5.5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg></i>yourbrand-logo.svg</button>
                <button type="button" class="logo-opt" aria-pressed="false" data-logo="spark"><i class="lg lg--spark"><svg class="g-spark" viewBox="0 0 24 24"><path d="M12 4.5l1.9 5.6 5.6 1.9-5.6 1.9-1.9 5.6-1.9-5.6-5.6-1.9 5.6-1.9z" fill="currentColor"/></svg></i>yourbrand-mark.svg</button>
              </div>
            </div>
            <div class="ctrl-g"><small>BRAND COLOR</small>
              <div class="sw" role="group" aria-label="Preview brand color">
                <button type="button" aria-pressed="true" aria-label="Orange" style="background:#ff4904" data-c="#ff4904"></button>
                <button type="button" aria-pressed="false" aria-label="Blue" style="background:#1d4ed8" data-c="#1d4ed8"></button>
                <button type="button" aria-pressed="false" aria-label="Green" style="background:#17734a" data-c="#17734a"></button>
                <button type="button" aria-pressed="false" aria-label="Violet" style="background:#6d28d9" data-c="#6d28d9"></button>
                <button type="button" aria-pressed="false" aria-label="Ink" style="background:#0f1420" data-c="#0f1420"></button>
              </div>
            </div>
            <div class="ctrl-g" aria-hidden="true"><small>WORKFLOWS</small>
              <div class="tg">Self-service upgrades <b></b></div>
              <div class="tg">Usage alerts <b></b></div>
              <div class="tg">Custom onboarding <b class="off"></b></div>
            </div>
          </div>
          <div class="phone" aria-hidden="true">
            <div class="phone-s">
              <div class="ph-top"><span class="ph-brand"><i class="ph-logo"><svg class="g-ring" viewBox="0 0 24 24"><path d="M12 6.5a5.5 5.5 0 1 0 5.5 5.5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg><svg class="g-spark" viewBox="0 0 24 24"><path d="M12 4.5l1.9 5.6 5.6 1.9-5.6 1.9-1.9 5.6-1.9-5.6-5.6-1.9 5.6-1.9z" fill="currentColor"/></svg></i><small>YOURBRAND</small></span><b>Hi Alex</b></div>
              <div class="ph-card"><small>DATA LEFT</small><b>11.4 GB</b><div class="ph-meter"><i></i></div></div>
              <div class="ph-list">
                <div class="ph-row"><span>Unlimited 5G</span><em>active</em></div>
                <div class="ph-row"><span>Travel add-on</span><em>30 days</em></div>
                <div class="ph-row"><span>Next bill</span><em>Oct 12</em></div>
              </div>
              <div class="ph-cta">Manage plan</div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 03 -->
    <div class="feat rv">
      <div class="feat-copy">
        <span class="feat-num">03</span>
        <span class="feat-tag">Partner Relationships</span>
        <h3>Turn Support into Revenue</h3>
        <p>Transform support into revenue-generating function that drives growth by upselling data plans and premium features directly in the portal, tracking feature adoption to drive retention and converting cost center into strategic revenue driver.</p>
      </div>
      <div class="panel" aria-hidden="true">
        <div class="panel-h"><span>uxhub / support</span><span class="live">routing</span></div>
        <div class="flow3">
          <div class="tix">
            <div class="tk done"><svg viewBox="0 0 16 16"><path d="M2 5h12v2a1.5 1.5 0 0 0 0 3v2H2v-2a1.5 1.5 0 0 0 0-3z"/></svg>Ticket 1<em>resolved</em></div>
            <div class="tk done"><svg viewBox="0 0 16 16"><path d="M2 5h12v2a1.5 1.5 0 0 0 0 3v2H2v-2a1.5 1.5 0 0 0 0-3z"/></svg>Ticket 2<em>resolved</em></div>
            <div class="tk"><svg viewBox="0 0 16 16"><path d="M2 5h12v2a1.5 1.5 0 0 0 0 3v2H2v-2a1.5 1.5 0 0 0 0-3z"/></svg>Ticket 3<em>routing</em></div>
            <div class="tk"><svg viewBox="0 0 16 16"><path d="M2 5h12v2a1.5 1.5 0 0 0 0 3v2H2v-2a1.5 1.5 0 0 0 0-3z"/></svg>Ticket 4<em>new</em></div>
          </div>
          <svg class="conn" viewBox="0 0 44 2" preserveAspectRatio="none"><line x1="0" y1="1" x2="44" y2="1"/></svg>
          <div class="router"><div>
            <svg viewBox="0 0 24 24"><path d="M12 2l2.2 6.8L21 11l-6.8 2.2L12 20l-2.2-6.8L3 11l6.8-2.2z" fill="#ff4904"/><path d="M19 2l.8 2.2L22 5l-2.2.8L19 8l-.8-2.2L16 5l2.2-.8z" fill="#ff4904"/></svg>
            <b>Spenza<br>AI Support Router</b><small>AUTO-TRIAGE</small>
          </div></div>
          <svg class="conn" viewBox="0 0 44 2" preserveAspectRatio="none"><line x1="0" y1="1" x2="44" y2="1"/></svg>
          <div class="offer">
            <small>IN-PORTAL OFFER</small>
            <b>Running low on data?</b>
            <span>Add 10 GB to this cycle, applied instantly.</span>
            <div class="go"><span>Add to plan</span><span>+$8</span></div>
          </div>
        </div>
        <div class="kpis rv">
          <div class="kpi"><small>TAT</small><b>&lt;24 HOURS</b></div>
          <div class="kpi"><small>SLA ADHERENCE</small><b>98%</b></div>
          <div class="kpi"><small>FEATURE ADOPTION</small><div class="bars"><i style="height:30%"></i><i style="height:38%"></i><i style="height:46%"></i><i style="height:52%"></i><i style="height:64%"></i><i style="height:78%"></i><i style="height:96%"></i></div></div>
        </div>
      </div>
    </div>
  </div>
</section>
