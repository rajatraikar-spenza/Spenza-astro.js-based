---
/** UX Hub: Launch a Branded Telecom Experience Your Customers Actually Remember */
---

<section class="hero">
  <div class="wrap hero-in">
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">UX Hub</p>
        <h1>Launch a <em class="s">Branded Telecom Experience</em> Your Customers Actually Remember</h1>
        <p class="hero-lede">Turn customer experience into a competitive advantage. UXHub helps MVNOs increase ARPU, reduce churn, and streamline support operations with a fully branded subscriber portal built for self-service.</p>
        <div class="hero-cta">
          <a class="btn btn--acc" href="#demo">Book Your Demo Now</a>
          <a class="btn btn--line" href="/contact-us/">Chat With Us</a>
        </div>
      </div>

      <div class="pv" aria-hidden="true">
        <div class="pv-win">
          <div class="pv-bar"><span class="pv-dots"><b></b><b></b><b></b></span><span class="pv-url">portal.yourbrand.com</span><span style="width:39px"></span></div>
          <div class="pv-body">
            <div class="pv-side">
              <div class="pv-brand"><i></i>YourBrand</div>
              <div class="pv-nav on">Overview</div>
              <div class="pv-nav">Plans</div>
              <div class="pv-nav">Usage</div>
              <div class="pv-nav">Billing</div>
              <div class="pv-nav">Support</div>
            </div>
            <div class="pv-main">
              <div class="pv-top">
                <div><small>MY ACCOUNT</small><b>Welcome back, Alex</b></div>
                <span class="pill pill--ok">active</span>
              </div>
              <div class="pv-cards">
                <div class="pv-card">
                  <small>DATA THIS CYCLE</small>
                  <div class="pv-use">
                    <svg viewBox="0 0 100 100"><circle cx="50" cy="50" r="42" fill="none" stroke="#efebe4" stroke-width="10"/><circle class="ring" cx="50" cy="50" r="42" fill="none" stroke-width="10" stroke-linecap="round" transform="rotate(-90 50 50)"/></svg>
                    <div><b>18.6 GB</b><span>of 30 GB</span></div>
                  </div>
                </div>
                <div class="pv-card pv-plan">
                  <small>CURRENT PLAN</small>
                  <b>Unlimited 5G</b>
                  <span>Renews Oct 12</span>
                  <span class="go">Upgrade plan</span>
                </div>
              </div>
              <div class="pv-lines">
                <div class="pv-line"><span>Line 1 <span class="mono">&middot; eSIM</span></span><span class="pv-bar2"><i style="width:62%"></i></span><span class="mono">5G</span></div>
                <div class="pv-line"><span>Line 2 <span class="mono">&middot; eSIM</span></span><span class="pv-bar2"><i style="width:34%"></i></span><span class="mono">5G</span></div>
                <div class="pv-line"><span>Tablet <span class="mono">&middot; data</span></span><span class="pv-bar2"><i style="width:18%"></i></span><span class="mono">LTE</span></div>
              </div>
            </div>
          </div>
        </div>
        <div class="pv-toast"><i>&#10003;</i><div><b>Plan upgraded</b><span>self-service &middot; no ticket</span></div></div>
      </div>
    </div>
  </div>
</section>
