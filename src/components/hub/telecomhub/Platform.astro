---
/**
 * Telecom Hub: One Platform for All Connectivity Management
 *
 * The `.code` sample is `white-space: pre`. Written in the markup, Astro would
 * collapse its line breaks and read its braces as expressions, so it is a
 * string, set as HTML.
 */
const CODE = `<span class="k">GET</span> /v1/carriers?country=<span class="s">"DE"</span>
<span class="c">// one API, every operator</span>
{ <span class="s">"carriers"</span>: 4, <span class="s">"network"</span>: <span class="s">"spenza"</span> }`;
