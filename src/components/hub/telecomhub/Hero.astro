---
/** Telecom Hub: Build Your Connectivity Business Faster. */
---

<section class="hero">
  <div class="wrap hero-in">
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Telecom Hub</p>
        <h1>Build Your Connectivity Business <em class="s">Faster.</em></h1>
        <p class="hero-lede">Manage 180+ carriers from one platform. Control pricing, automate scaling, and ensure compliance without the complexity.</p>
        <div class="hero-cta">
          <a class="btn btn--acc" href="#demo">Book Your Demo Now</a>
          <a class="btn btn--line" href="/contact-us/">Chat With Us</a>
        </div>
      </div>

      <div class="dash mk" aria-hidden="true">
        <div class="dash-win">
          <div class="dash-bar"><span>telecomhub / routing</span><span class="live">live</span></div>
          <div class="dash-body">
            <div class="kpi3">
              <div class="box"><small>Carriers</small><b>180+</b><em style="color:var(--muted)">one API</em></div>
              <div class="box"><small>eSIMs active</small><b>12,840</b><em class="up">&uarr; 214 today</em></div>
              <div class="box"><small>Failovers</small><b>0 drops</b><em style="color:var(--muted)">last 30 days</em></div>
            </div>
            <div class="box" style="padding:12px 0 4px">
              <div class="rt-row h"><span>Market</span><span>Signal</span><span>Latency</span><span style="text-align:right">State</span></div>
              <div class="rt-row"><span><b>Operator A</b><small>US &middot; 5G</small></span><span class="sig"><i style="width:86%"></i></span><span class="m">24 ms</span><span class="state on">routing</span></div>
              <div class="rt-row"><span><b>Operator B</b><small>UK &middot; LTE</small></span><span class="sig"><i style="width:78%;animation-delay:.6s"></i></span><span class="m">31 ms</span><span class="state on">routing</span></div>
              <div class="rt-row"><span><b>Operator C</b><small>DE &middot; LTE-M</small></span><span class="sig"><i style="width:64%;background:#c9c2b7;animation-delay:.7s"></i></span><span class="m">38 ms</span><span class="state sb">standby</span></div>
              <div class="rt-row"><span><b>Operator D</b><small>JP &middot; 5G</small></span><span class="sig"><i style="width:48%;background:#f0a500;animation-delay:.8s"></i></span><span class="m">57 ms</span><span class="state dg">degraded</span></div>
            </div>
            <div class="api"><span>PATCH /v1/sims/8944&hellip;/routing <em>{'{'}"policy":"cost+coverage"{'}'}</em></span><span class="ok">200 OK</span></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
