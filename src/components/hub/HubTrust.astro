---
/**
 * "Trusted. Secure. Compliant." — identical on all three hub pages.
 *
 * The badge images were base64 in the design, 75KB of it in every page's
 * HTML. They are files under /images/inline/ now, named by a hash of their
 * bytes so they cache for a year, and shared by all three pages.
 */
---

<section class="sec sec--white">
  <div class="wrap trust">
    <div class="rv">
      <h2 class="h2"><em class="s">Trusted.</em> Secure. Compliant.</h2>
      <p class="lede">All data is encrypted in transit and at rest using industry-leading standards. Information is collected through a privacy-first approach with strict access permissions.</p>
      <ul class="checks">
        <li><svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="10" fill="#ff4904"/><path d="M6 10.2l2.6 2.6L14 7.4" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>End-to-end connectivity management</li>
        <li><svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="10" fill="#ff4904"/><path d="M6 10.2l2.6 2.6L14 7.4" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>Plans across 180+ countries</li>
        <li><svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="10" fill="#ff4904"/><path d="M6 10.2l2.6 2.6L14 7.4" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>Optimize telecom operations</li>
      </ul>
      <a class="btn btn--ink" href="#demo">Get Started <i>&rarr;</i></a>
    </div>
    <div class="badges rv">
      <div class="badge"><img src="/images/inline/a44f57ff6610.webp" alt="Cloud" width="64" height="64" loading="lazy" decoding="async"><span>Cloud</span></div>
      <div class="badge"><img src="/images/inline/d3b14c806a02.webp" alt="Stripe on Payments" width="64" height="64" loading="lazy" decoding="async"><span>Stripe on Payments</span></div>
      <div class="badge"><img src="/images/inline/cca84e86716e.webp" alt="Okta" width="64" height="64" loading="lazy" decoding="async"><span>Okta</span></div>
      <div class="badge"><img src="/images/inline/51fe7b259f5c.webp" alt="Uptime" width="64" height="64" loading="lazy" decoding="async"><span>Uptime</span></div>
      <div class="badge"><img src="/images/inline/6982d9ecdf2b.webp" alt="GDPR" width="64" height="64" loading="lazy" decoding="async"><span>GDPR</span></div>
      <div class="badge"><img src="/images/inline/e0ebc20735d3.webp" alt="Pre-Built Tax Integrations" width="64" height="64" loading="lazy" decoding="async"><span>Pre-Built Tax Integrations</span></div>
      <div class="badge"><img src="/images/inline/eaeef4eaf39e.webp" alt="Uptime" width="64" height="64" loading="lazy" decoding="async"><span>Uptime</span></div>
      <div class="badge badge--lock" aria-hidden="true">
        <svg viewBox="0 0 64 64"><circle cx="32" cy="32" r="30" fill="none" stroke="#ffffff26"/><circle cx="32" cy="32" r="22" fill="none" stroke="#ff4904" stroke-dasharray="3 5"/><rect x="22" y="29" width="20" height="16" rx="3" fill="#ff4904"/><path d="M26 29v-4a6 6 0 0 1 12 0v4" fill="none" stroke="#fff" stroke-width="2.4"/><circle cx="32" cy="36" r="2" fill="#fff"/></svg>
      </div>
    </div>
  </div>
</section>
