---
/**
 * The site's analytics: GA4 and Microsoft Clarity, both loading on page open
 * for every visitor.
 *
 * Neither is behind a consent decision. That is a deliberate instruction from
 * the site owner, taken with the trade-off stated: `gtag.js` writes `_ga` and
 * Clarity writes `_clck`/`_clsk`/`CLID`, all on the first request, so the site
 * measures first and informs second — the arrangement ePrivacy/GDPR consent
 * rules exist to prevent, and the HubSpot portal being on EU1 says the audience
 * includes the EU. It is recorded here so nobody later reads it as a bug and
 * quietly "fixes" it.
 *
 * There is no cookie notice either. The site used to show a bar at the foot of
 * every page saying what is collected, with one button that dismissed it
 * (`public/scripts/consent.js`); it was removed from the whole site on request,
 * and nothing about what is measured changed with it. If analytics should ever
 * become optional, the honest shape is a stored answer that gates the two
 * `start` paths below, and a bar that offers Accept and Reject together with
 * that gate — never buttons wired to nothing.
 *
 * `is:inline` is load-bearing on both blocks. Astro's default is to treat a
 * `<script>` in a component as a module to hoist, bundle and rewrite — which
 * would move them into `/_astro/`, defer them behind the bundle, and turn a
 * first-party inline tag into a third request.
 *
 * Rendered in `<head>` by all three layouts, so this is the whole site: the
 * mirrored marketing pages and archives (`WpLayout`), every post
 * (`ArticleLayout`), and the rebuild preview (`BaseLayout`).
 */
import { CLARITY_PROJECT_ID, GA_MEASUREMENT_ID } from '../../scripts/lib/config.mjs';

/*
 * The standard GA4 bootstrap, unchanged apart from the id. `dataLayer` and
 * `gtag` are created here rather than by the loader so that calls made before
 * googletagmanager.com answers are queued instead of throwing.
 */
const ga = `window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', ${JSON.stringify(GA_MEASUREMENT_ID)});`;

// `JSON.stringify` rather than plain interpolation: the value reaches an inline
// script, and config.mjs already rejects anything that is not alphanumeric, but
// the two guards cost nothing and the failure mode without them is a script tag
// on every page of the site.
const clarity = `(function (w, d) {
  var ID = ${JSON.stringify(CLARITY_PROJECT_ID)};
  if (!ID) return;

  /* Clarity's own snippet, unchanged apart from the id. */
  (function(c,l,a,r,i,t,y){
      c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
      t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
      y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
  })(w, d, "clarity", "script", ID);
})(window, document);`;
---

{/*
  GA4 and Clarity, both unconditional — see the note at the top of this file.
  As high in the head as the layouts can put them: the tags time a session from
  the moment they run, so anything in front of them is time the visit is not
  being measured.
*/}
{GA_MEASUREMENT_ID && (
  <>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
    <script is:inline type="text/javascript" set:html={ga} />
  </>
)}

<script is:inline type="text/javascript" set:html={clarity} />
