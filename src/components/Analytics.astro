---
/**
 * The site's analytics: GA4, Microsoft Clarity and the OpenAI (ChatGPT Ads)
 * Measurement Pixel, all loading on page open for every visitor.
 *
 * None is behind a consent decision. That is a deliberate instruction from
 * the site owner, taken with the trade-off stated: `gtag.js` writes `_ga` and
 * Clarity writes `_clck`/`_clsk`/`CLID`, all on the first request, so the site
 * measures first and informs second — the arrangement ePrivacy/GDPR consent
 * rules exist to prevent, and the HubSpot portal being on EU1 says the audience
 * includes the EU. It is recorded here so nobody later reads it as a bug and
 * quietly "fixes" it.
 *
 * There is no cookie notice either. The site used to show a bar at the foot of
 * every page saying what is collected, with one button that dismissed it
 * (`public/scripts/consent.js`); it was removed from the whole site on request,
 * and nothing about what is measured changed with it. If analytics should ever
 * become optional, the honest shape is a stored answer that gates the two
 * `start` paths below, and a bar that offers Accept and Reject together with
 * that gate — never buttons wired to nothing.
 *
 * `is:inline` is load-bearing on both blocks. Astro's default is to treat a
 * `<script>` in a component as a module to hoist, bundle and rewrite — which
 * would move them into `/_astro/`, defer them behind the bundle, and turn a
 * first-party inline tag into a third request.
 *
 * Rendered in `<head>` by all three layouts, so this is the whole site: the
 * mirrored marketing pages and archives (`WpLayout`), every post
 * (`ArticleLayout`), and the rebuild preview (`BaseLayout`).
 */
import { CLARITY_PROJECT_ID, GA_MEASUREMENT_ID, OAI_PIXEL_ID } from '../../scripts/lib/config.mjs';

/*
 * The standard GA4 bootstrap, unchanged apart from the id. `dataLayer` and
 * `gtag` are created here rather than by the loader so that calls made before
 * googletagmanager.com answers are queued instead of throwing.
 */
const ga = `window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', ${JSON.stringify(GA_MEASUREMENT_ID)});`;

// `JSON.stringify` rather than plain interpolation: the value reaches an inline
// script, and config.mjs already rejects anything that is not alphanumeric, but
// the two guards cost nothing and the failure mode without them is a script tag
// on every page of the site.
const clarity = `(function (w, d) {
  var ID = ${JSON.stringify(CLARITY_PROJECT_ID)};
  if (!ID) return;

  /* Clarity's own snippet, unchanged apart from the id. */
  (function(c,l,a,r,i,t,y){
      c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
      t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
      y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
  })(w, d, "clarity", "script", ID);
})(window, document);`;

/*
 * docs.spenza.com is a separate site (Mintlify) that loads the same Clarity
 * project. Clarity files any click that leaves the host under its built-in
 * "Outbound click" smart event, which cannot be edited, so a visitor heading
 * to the docs looked like one leaving the site. This gives those clicks their
 * own event and a tag, so they can be told apart from real exits, and sends
 * the same to GA4. Capture phase, because menus stop propagation.
 */
const docsLinks = `document.addEventListener("click", function (e) {
  var a = e.target && e.target.closest && e.target.closest("a[href]");
  if (!a) return;
  var u;
  try { u = new URL(a.href, location.href); } catch (_) { return; }
  if (u.hostname !== "docs.spenza.com") return;
  if (window.clarity) {
    window.clarity("event", "docs_click");
    window.clarity("set", "destination", "docs.spenza.com");
  }
  if (window.gtag) window.gtag("event", "docs_click", { link_url: u.href, source_page: location.pathname });
}, true);`;

/*
 * Where a conversion came from. Three jobs, all in the visitor's browser:
 *
 *   1. Arrival. `utm_*` on the landing URL is kept in two first-party cookies
 *      on `.spenza.com` — `sp_ft` (first touch, written once) and `sp_lt`
 *      (last touch) — so `web.spenza.com` can read them too: browser storage
 *      is per host, and the sign-up page is a different one from this site.
 *   2. Links. Every Login / Start-free-trial link to web.spenza.com gets
 *      `utm_source=<page it was clicked on>`, `utm_medium=website`,
 *      `utm_campaign=<login|start_free_trial>`, `utm_content=<nav|footer|body>`,
 *      plus `ft_source=<first-touch channel>` when there is one, so the channel
 *      that brought the visitor is not lost under the page name. A link that
 *      already carries its own `utm_*` (a sales email) is left alone.
 *   3. Counting. `cta_click` (GA4 + Clarity) for those links, the Contact Us
 *      links and the demo pop-up buttons; the form submit counterpart is in
 *      `hubspot-forms.js`, which reads `window.spAttribution` to stamp the
 *      same values on the HubSpot contact.
 *
 * UTM values are campaign labels, not personal data. Like the tags above, none
 * of this waits for a consent decision (see the note at the top of the file).
 * `is:inline` for the same reason as the others: it must run before the DOM.
 */
const attribution = `(function (w, d) {
  var DOMAIN = /(^|\\.)spenza\\.com$/.test(location.hostname) ? "; domain=.spenza.com" : "";
  var SECURE = location.protocol === "https:" ? "; secure" : "";
  var UTM = ["utm_source", "utm_medium", "utm_campaign", "utm_content"];

  function slug(s) { return String(s || "").toLowerCase().replace(/[^a-z0-9]+/g, "_").replace(/^_+|_+$/g, "").slice(0, 60); }
  function val(s) { return String(s || "").trim().toLowerCase().slice(0, 100); }
  function parse(h) { try { return new URL(h, location.href); } catch (_) { return null; } }
  function read(n) {
    var m = d.cookie.match(new RegExp("(?:^|;\\\\s*)" + n + "=([^;]*)"));
    if (!m) return null;
    try { return JSON.parse(decodeURIComponent(m[1])); } catch (_) { return null; }
  }
  function write(n, o, days) {
    try { d.cookie = n + "=" + encodeURIComponent(JSON.stringify(o)) + "; path=/; max-age=" + days * 86400 + "; samesite=lax" + DOMAIN + SECURE; } catch (_) {}
  }
  function store(n, o) {
    try {
      if (o === undefined) return JSON.parse(sessionStorage.getItem(n));
      sessionStorage.setItem(n, JSON.stringify(o));
    } catch (_) { return null; }
  }
  function pageKey() {
    var p = location.pathname.replace(/^\\/+|\\/+$/g, "");
    return p ? slug(p) : "homepage";
  }
  function placement(el) {
    return el.closest(".sn") ? "nav" : el.closest("footer") ? "footer" : "body";
  }

  /* 1. Arrival */
  var q = new URLSearchParams(location.search), seen = {}, any = false;
  UTM.forEach(function (k) { var v = val(q.get(k)); if (v) { seen[k] = v; any = true; } });
  if (any) {
    seen.t = Date.now();
    if (!read("sp_ft")) write("sp_ft", seen, 90);
    write("sp_lt", seen, 90);
  }

  /* 2. Links */
  function decorate(a) {
    var u = parse(a.href);
    if (!u || u.hostname !== "web.spenza.com") return;
    var m = u.pathname.match(/^\\/auth\\/(login|signup)/);
    if (!m || u.searchParams.has("utm_source")) return;
    var ft = read("sp_ft");
    u.searchParams.set("utm_source", pageKey());
    u.searchParams.set("utm_medium", "website");
    u.searchParams.set("utm_campaign", m[1] === "signup" ? "start_free_trial" : "login");
    u.searchParams.set("utm_content", placement(a));
    if (ft && ft.utm_source) u.searchParams.set("ft_source", ft.utm_source);
    a.href = u.toString();
  }
  function decorateAll() {
    var all = d.querySelectorAll('a[href*="web.spenza.com/auth/"]');
    for (var i = 0; i < all.length; i++) decorate(all[i]);
  }
  if (d.readyState === "loading") d.addEventListener("DOMContentLoaded", decorateAll); else decorateAll();

  /* 3. Counting */
  function classify(t) {
    if (!t || !t.closest) return null;
    var a = t.closest("a[href]");
    if (a) {
      var u = parse(a.href);
      if (u && u.hostname === "web.spenza.com" && /^\\/auth\\/signup/.test(u.pathname)) return { cta: "start_free_trial", a: a };
      if (u && u.hostname === "web.spenza.com" && /^\\/auth\\/login/.test(u.pathname)) return { cta: "login", a: a };
      if (u && u.hostname === location.hostname && /^\\/contact-us\\/?$/.test(u.pathname)) return { cta: "contact", a: a };
    }
    if (t.closest(".get-started")) return { cta: "popup_open" };
    return null;
  }
  function onClick(e) {
    if (e.type === "auxclick" && e.button !== 1) return;
    var hit = classify(e.target);
    if (!hit) return;
    if (hit.a) decorate(hit.a);
    var page = pageKey(), where = placement(e.target);
    store("sp_cta", { cta: hit.cta, page: page, placement: where, t: Date.now() });
    try { if (w.gtag) w.gtag("event", "cta_click", { cta: hit.cta, cta_page: page, cta_placement: where }); } catch (_) {}
    try { if (w.clarity) { w.clarity("event", "cta_click_" + hit.cta); w.clarity("set", "cta_page", page); } } catch (_) {}
  }
  d.addEventListener("click", onClick, true);
  d.addEventListener("auxclick", onClick, true);
  // Right-click > copy link, and cmd-click, read href before any click event.
  d.addEventListener("pointerdown", function (e) { var h = classify(e.target); if (h && h.a) decorate(h.a); }, true);

  /* What a form should record: the page the visitor converted on (or, for the
     Contact Us page, the page whose link brought them), the CTA, and the
     channel that first brought them here. */
  w.spAttribution = {
    forForm: function (form) {
      var last = store("sp_cta"), ft = read("sp_ft");
      var fresh = last && Date.now() - last.t < 30 * 60 * 1000;
      var page = pageKey(), cta = "inline_form", where = placement(form);
      if (form.closest(".popup-overlay, .popup-container, .gp-modal")) {
        cta = "popup_open";
        where = fresh && last.cta === "popup_open" ? last.placement : "popup";
      } else if (/^\\/contact-us\\/?$/.test(location.pathname)) {
        cta = "contact";
        if (fresh && last.cta === "contact") { page = last.page; where = last.placement; }
      }
      var out = { utm_source: page, utm_medium: "website", utm_campaign: cta, utm_content: where };
      if (ft && ft.utm_source) out.first_touch_source = ft.utm_source;
      return out;
    }
  };
})(window, document);`;

/*
 * OpenAI's Measurement Pixel loader and init, unchanged apart from the id and
 * `debug: true`, which was dropped once Ads Manager showed events — it logs
 * every SDK step to each visitor's console. Add it back to debug locally.
 * (https://developers.openai.com/ads/measurement-pixel). It records nothing on
 * its own — the pixel only sends what is `measure`d — so a page view is sent
 * here, and `lead_created` from `hubspot-forms.js` on a confirmed submission.
 */
const oaiPixel = `!function(w,d,s,u){if(w.oaiq)return;var q=function(){q.q.push(arguments)};q.q=[];w.oaiq=q;var j=d.createElement(s);j.async=1;j.src=u;var f=d.getElementsByTagName(s)[0];f.parentNode.insertBefore(j,f)}(window,document,"script","https://bzrcdn.openai.com/sdk/oaiq.min.js");
oaiq("init",{pixelId:${JSON.stringify(OAI_PIXEL_ID)}});
oaiq("measure","page_viewed",{type:"contents"});`;
---

{/*
  GA4, Clarity and the OpenAI pixel, all unconditional — see the note at the top of this file.
  As high in the head as the layouts can put them: the tags time a session from
  the moment they run, so anything in front of them is time the visit is not
  being measured.
*/}
{GA_MEASUREMENT_ID && (
  <>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
    <script is:inline type="text/javascript" set:html={ga} />
  </>
)}

<script is:inline type="text/javascript" set:html={clarity} />

<script is:inline type="text/javascript" set:html={docsLinks} />

<script is:inline type="text/javascript" set:html={attribution} />

{OAI_PIXEL_ID && <script is:inline type="text/javascript" set:html={oaiPixel} />}
