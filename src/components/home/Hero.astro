---
/**
 * Hero: the headline beside a "Live on Spenza" stage that cycles through three
 * customers — where each is live on a world map, and what its own customer
 * app shows. From the spenza-home-hero-updated design; styles in
 * styles/home-hero.css, behaviour in scripts/home-hero.js.
 *
 * The first customer is rendered here, so the stage is complete before any
 * script runs; the script only swaps in the next one. The stage is drawn at
 * 660x630 and scaled to fit; the inline script below scales it before first
 * paint, so a phone never sees it at full size.
 *
 * "Book a demo" carries `get-started`, which opens the site's Get Started popup;
 * `#demo` is where it goes without JavaScript.
 */
import { HERO_CUSTOMERS, brandStyle, labelStyle } from './hero-customers';
import { MAP_DOTS } from './hero-map-dots';

const stats = [
  ['88% faster', 'to launch a market'],
  ['180+', 'countries'],
  ['30+', 'operator integrations'],
  ['4 hubs', 'one API, one invoice'],
];

const c = HERO_CUSTOMERS[0];
const p = c.phone;
const data = HERO_CUSTOMERS.map(({ logoRatio, ...rest }) => rest);
---

<section class="sh sh-hero" aria-labelledby="hero-title">
  <div class="sh-wrap sh-hero-grid">
    <div>
      <div class="sh-eyebrow">MVNE PLATFORM &middot; eSIM, IoT CONNECTIVITY, BILLING &amp; AI VOICE</div>
      <h1 id="hero-title">Turn Mobile Connectivity Into Your <em>Next Product.</em></h1>
      <p class="sh-lede">Bring your own network, customize your plans, and own the customer experience. We handle the telecom complexity.</p>
      <div class="sh-ctas">
        <a class="sh-btn sh-btn-acc get-started" href="#demo">Book a demo</a>
        <a class="sh-btn sh-btn-line" href="https://docs.spenza.com/">Read the API docs</a>
      </div>
      <dl class="sh-stats">
        {stats.map(([value, label]) => <div><dt>{value}</dt> <dd>{label}</dd></div>)}
      </dl>
    </div>

    <div class="sh-stage-box" id="sh-stageBox">
      <div class="sh-stage" id="sh-stage" style={brandStyle(c)}>
        <div class="sh-content">
          <div class="sh-tabs" role="group" aria-label="Customers running on Spenza">
            <span class="sh-tabs-label">Live on Spenza</span>
            {HERO_CUSTOMERS.map((x, i) => (
              <button type="button" class="sh-tab" data-i={i} aria-pressed={i === 0 ? 'true' : 'false'}>{x.name}<span class="sh-bar"></span></button>
            ))}
          </div>

          <div class="sh-card">
            <div class="sh-who sh-swap">
              <div class="sh-who-text">
                <img class="sh-logo-card" id="sh-logo" src={c.logo} alt={c.name} height={c.logoH[0]} width={Math.round(c.logoH[0] * c.logoRatio)} style={`height:${c.logoH[0]}px`} />
                <span class="sh-who-sub" id="sh-sub">{c.sub}</span>
              </div>
            </div>
            <div class="sh-kpis sh-swap">
              <div class="sh-kpi"><span class="sh-kpi-v" id="sh-kMarkets">{c.markets.length}</span><span class="sh-kpi-l">markets live</span></div>
              <div class="sh-kpi"><span class="sh-kpi-v" id="sh-kNetworks">{c.networks}</span><span class="sh-kpi-l">networks live</span></div>
            </div>
          </div>

          <div class="sh-map" id="sh-map" role="img" aria-label={`World map showing ${c.name} live in ${c.markets.map(m => m.name).join(' and ')}`}>
            <svg viewBox="0 0 580 216" aria-hidden="true" focusable="false">
              <path class="sh-dots" d={MAP_DOTS} />
              <g id="sh-pins" class="sh-swap">
                {c.markets.map(m => (
                  <g class="sh-pin" transform={`translate(${m.x} ${m.y})`}>
                    <circle class="sh-halo" r="8" /><circle class="sh-ring" r="5" /><circle class="sh-core" r="3.6" />
                  </g>
                ))}
              </g>
            </svg>
            <div id="sh-labels" class="sh-swap">
              {c.markets.map(m => <span class="sh-pinlabel" style={labelStyle(m, c.markets.length)}>{m.name} · live</span>)}
            </div>
          </div>

          <div class="sh-caption">
            <span class="sh-swap" id="sh-capText">{c.caption}</span>
          </div>
        </div>

        <div class="sh-phone" aria-hidden="true">
          <span class="sh-phone-tag">Customer app</span>
          <div class="sh-screen sh-swap">
            <div class="sh-app-head">
              <img class="sh-logo-app" id="sh-pLogo" src={c.logo} alt="" height={c.logoH[1]} width={Math.round(c.logoH[1] * c.logoRatio)} style={`height:${c.logoH[1]}px`} />
              <span class="sh-avatar"></span>
            </div>
            <div class="sh-alert">
              <div class="sh-alert-top"><span id="sh-aLabel">{p.aLabel}</span><span>now</span></div>
              <span class="sh-alert-text" id="sh-aText">{p.aText}</span>
              <div class="sh-alert-btns"><span id="sh-aBtn">{p.aBtn}</span><span>Dismiss</span></div>
            </div>
            <div class="sh-plan">
              <span class="sh-plan-l" id="sh-plL">{p.plL}</span>
              <span class="sh-plan-n" id="sh-plN">{p.plN}</span>
              <span class="sh-plan-big" id="sh-plBig">{p.plBig}</span>
              <span class="sh-plan-cap" id="sh-plCap">{p.plCap}</span>
            </div>
            <div class="sh-rows">
              <div class="sh-row"><span id="sh-r1k">{p.rows[0][0]}</span><span id="sh-r1v">{p.rows[0][1]}</span></div>
              <div class="sh-row"><span id="sh-r2k">{p.rows[1][0]}</span><span id="sh-r2v">{p.rows[1][1]}</span></div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <script is:inline>
      (function () {
        var box = document.getElementById('sh-stageBox');
        var s = Math.min(1, (box.clientWidth || 660) / 660);
        box.firstElementChild.style.transform = 'scale(' + s + ')';
        box.style.height = 630 * s + 'px';
      })();
    </script>
  </div>
  <p class="sh-sr-only" aria-live="polite" id="sh-announce"></p>
  <script is:inline type="application/json" id="sh-data" set:html={JSON.stringify(data)} />
</section>
