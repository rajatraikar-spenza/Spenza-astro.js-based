---
/**
 * Hero: the headline beside the "Live on Spenza" stage (HeroStage.astro),
 * from the spenza-home-hero-updated design. Styles in styles/home-hero.css,
 * behaviour in scripts/home-hero.js.
 *
 * "Book a demo" carries `get-started`, which opens the site's Get Started popup;
 * `#demo` is where it goes without JavaScript.
 *
 * The headline is three lines, the last of them a single word naming what
 * connectivity becomes (a service, a product, an add-on). scripts/home-hero.js
 * rolls it over letter by letter from `data-words`, every four seconds. The
 * stage beside it is the static one — RocketPhone, no tabs; /mvne/ has the
 * cycling one. On phones the stage sits under the buttons.
 */
import HeroStage from './HeroStage.astro';
import { HERO_CUSTOMERS } from './hero-customers';

/** The headline's last word, in the customers' order. */
const words = HERO_CUSTOMERS.map(x => x.word);

const stats = [
  ['88% faster', 'to launch a market'],
  ['180+', 'countries'],
  ['30+', 'operator integrations'],
  ['4 hubs', 'one API, one invoice'],
];
---

<section class="sh sh-hero" aria-labelledby="hero-title">
  <div class="sh-wrap sh-hero-grid">
    <div>
      <div class="sh-eyebrow">MVNE PLATFORM &middot; eSIM, IoT CONNECTIVITY, BILLING &amp; AI VOICE</div>
      <h1 id="hero-title"><span class="sh-l">Turn Connectivity</span> <span class="sh-l">Into Your Next</span> <span class="sh-l"><em class="sh-rot sh-roll" id="sh-word" data-words={JSON.stringify(words)}><span>{words[0]}</span></em><em>.</em></span></h1>
      <p class="sh-lede">Bring your own network, customize your plans, and own the customer experience. We handle the telecom complexity.</p>
      <div class="sh-ctas">
        <a class="sh-btn sh-btn-acc get-started" href="#demo">Book a demo</a>
        <a class="sh-btn sh-btn-line" href="https://docs.spenza.com/">Read the API docs</a>
      </div>
      <dl class="sh-stats">
        {stats.map(([value, label]) => <div><dt>{value}</dt> <dd>{label}</dd></div>)}
      </dl>
    </div>

    <HeroStage />
  </div>
</section>
