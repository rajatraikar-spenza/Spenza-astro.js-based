---
/**
 * The Alternatives: direct with a carrier, build it in-house, or Spenza,
 * across seven capabilities. Design from the Figma file's "Spenza Homepage /
 * Backup" frame; copy is the live site's. Styles in styles/home-sections.css.
 *
 * The board starts at rest and "pops" the Spenza column when it scrolls into
 * view, then a focus band walks the rows (scripts/home.js). On phones each row
 * becomes a card.
 */
import badgeDot from '../../assets/home/sz/badge-dot.svg?url';
import check from '../../assets/home/sz/check.svg?url';
import logo from '../../assets/home/sz/logo.svg?url';
import mark from '../../assets/home/sz/mark.svg?url';

const rows = [
  ['Time to first market', 'Carrier contracts delay launch.', 'Build integrations before launch.', 'Go live with integrations and billing in place.'],
  ['Adding new markets', 'A fifth contract, a fifth portal, a fifth invoice.', 'A fifth integration your team now owns forever.', 'A line in a config. Same dashboard, same invoice.'],
  ['Cost per line at scale', 'Smartphone pricing on sensor traffic, and no lever to pull.', 'Better rates, if you win a wholesale negotiation.', 'Pooled plans and routing across 30+ operators. 30% typical reduction.'],
  ['Changing networks', 'A truck roll and a physical SIM swap.', 'You build and maintain the multi-IMSI logic yourself.', 'Over the air, per device, no SIM swap.'],
  ['Billing your own customers', 'Out of scope. You add a billing vendor.', 'Rating, tax, KYC, and payouts are all yours to maintain.', 'Branded checkout, invoicing, and reseller payouts included.'],
  ['Powering AI agents', 'A separate CPaaS vendor and a separate invoice.', 'Another API, another number inventory to manage.', 'AgentHub. Same API, same billing rails.'],
  ['When something breaks', 'A general support queue, at the tier your contract covers.', 'Every carrier escalation lands on your on-call rotation.', 'A named launch team and a shared channel from day one.'],
];
---

<section class="sz-alt" aria-labelledby="sz-alt-title" data-fit>
  <div class="sz-wrap" data-fit-box>
    <div class="sz-alt__head">
      <div class="sz-alt__headblock">
        <p class="sz-eyebrow"><span class="sz-eyebrow__rule" aria-hidden="true"></span>THE ALTERNATIVES</p>
        <h2 class="sz-alt__title" id="sz-alt-title">Three ways to get <br />connectivity.<br /><em>One of them scales.</em></h2>
      </div>
      <p class="sz-alt__lede">Already working with carriers or building your own stack? See how Spenza compares on cost, flexibility, and operations.</p>
    </div>

    <div class="sz-cmp" data-state="rest" data-row="0">
      <div class="sz-cmp__tray" aria-hidden="true"></div>
      <div class="sz-cmp__frame" aria-hidden="true"><span class="sz-cmp__bar"></span></div>
      <div class="sz-cmp__band" aria-hidden="true"></div>
      <div class="sz-cmp__cell" aria-hidden="true"></div>

      <div class="sz-cmp__grid sz-cmp__top">
        <p class="sz-cmp__compare">CAPABILITY</p>
        <div class="sz-cmp__colhead sz-cmp__c1">
          <p class="sz-cmp__coltitle">Direct with a carrier</p>
          <p class="sz-cmp__colsub">THE USUAL FIRST MOVE</p>
        </div>
        <div class="sz-cmp__colhead sz-cmp__c2">
          <p class="sz-cmp__coltitle">Build it in-house</p>
          <p class="sz-cmp__colsub">THE IN-HOUSE BUILD</p>
        </div>
        <div class="sz-cmp__colhead sz-cmp__c3">
          <div class="sz-cmp__brand">
            <span class="sz-cmp__logo"><img src={logo} alt="Spenza" width="107" height="34" loading="lazy" decoding="async" /></span>
            <span class="sz-cmp__badge"><img src={badgeDot} alt="" width="5" height="5" />THE ONE THAT SCALES</span>
          </div>
          <p class="sz-cmp__colsub">ONE PLATFORM, FOUR HUBS</p>
        </div>
      </div>

      <ol class="sz-cmp__rows">
        {rows.map(([label, carrier, build, spenza], i) => (
          <li class="sz-cmp__row">
            <span class="sz-cmp__num">{String(i + 1).padStart(2, '0')}</span>
            <span class="sz-cmp__label">{label}</span>
            <div class="sz-cmp__alt sz-cmp__alt--carrier"><img src={mark} alt="" width="16" height="16" /><p><b>DIRECT WITH A CARRIER</b>{carrier}</p></div>
            <div class="sz-cmp__alt sz-cmp__alt--build"><img src={mark} alt="" width="16" height="16" /><p><b>BUILD IT IN-HOUSE</b>{build}</p></div>
            <div class="sz-cmp__sz"><img class="sz-cmp__check" src={check} alt="" width="20" height="20" /><p><span class="hm-sr">Spenza: </span>{spenza}</p></div>
          </li>
        ))}
      </ol>

      <ul class="sz-cmp__hubs" aria-label="Spenza hubs">
        <li>TelecomHub</li><li>ControlHub</li><li>UXHub</li><li>AgentHub</li>
      </ul>
    </div>

    <div class="sz-alt__callout">
      <div class="sz-alt__callcopy">
        <p class="sz-alt__calltitle">Already working with carriers or running your own stack?</p>
        <p class="sz-alt__callbody">Keep your existing operator relationships and customer setup. Move connectivity and billing to Spenza at your own pace.</p>
      </div>
      <a class="sz-btn-ink" href="#demo">Talk to us about migration</a>
    </div>
  </div>
</section>
