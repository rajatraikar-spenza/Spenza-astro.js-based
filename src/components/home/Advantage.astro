---
/**
 * The Spenza advantage, built like the "How it works" panel on livekit.com:
 * four numbered hubs beside an isometric stack of the hub cards. On a wide
 * screen the panel holds still while the page scrolls past it, and the scroll
 * walks the steps — the cards before the current one pack back, it slides out
 * with room either side, lights up, and trails outline frames back into the
 * stack. Narrower screens step through on a timer; phones get the steps alone.
 *
 * Behaviour in src/scripts/home.js; layout in styles/home-sections.css.
 * It sits below the fold, so the cards load lazily.
 */
import agent from '../../assets/home/agent.svg?url';
import control from '../../assets/home/control.svg?url';
import telecom from '../../assets/home/telecom.svg?url';
import ux from '../../assets/home/ux.svg?url';

/** Front to back: the order of the steps, and of the cards in the stack. */
const hubs = [
  {
    id: 'ux', src: ux, n: '01', tag: 'BRAND', name: 'UXHub',
    title: 'Your brand in your customers’ hands',
    text: 'A branded portal and app for plans, checkout, billing and support, so subscribers serve themselves and spend more.',
  },
  {
    id: 'control', src: control, n: '02', tag: 'CONTROL', name: 'ControlHub',
    title: 'Your plans, your prices',
    text: 'Turn wholesale operator plans into your own products, with parent-child billing for every reseller and real-time plan optimisation.',
  },
  {
    id: 'telecom', src: telecom, n: '03', tag: 'NETWORK', name: 'TelecomHub',
    title: 'One API to 180+ carriers',
    text: 'Operator access, provisioning and connectivity management in one integration, so you launch new markets in days.',
  },
  {
    id: 'agent', src: agent, n: '04', tag: 'INTELLIGENCE', name: 'AgentHub',
    title: 'Real phone numbers for AI voice',
    text: 'Give your AI agents real numbers and live calls, on the same stack and the same invoice as everything else.',
  },
];
---

<section class="hm-how" aria-labelledby="platform-title">
  <div class="hm-how__track">
    <div class="hm-how__panel">
      <svg class="hm-how__grid" viewBox="0 0 800 640" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
        <path d="M-40 520 L560 174 M60 700 L840 250 M260 760 L880 402 M-80 300 L360 46 M120 -40 L880 398 M-60 120 L780 605 M-120 330 L620 757 M380 -60 L900 240" />
      </svg>

      <div class="hm-how__copy">
        <div class="hm-eyebrow">THE SPENZA ADVANTAGE</div>
        <h2 id="platform-title" class="hm-h2 hm-how__title">The Telecom Foundation Behind Your Business.</h2>
        <p class="hm-how__lede">Pre-integrated telecom infrastructure, instead of piecing together carriers, provisioning, billing and customer tools yourself.</p>

        <ol class="hm-how__steps">
          {hubs.map((hub, i) => (
            <li class="hm-how__step" data-hub={hub.id} aria-current={i === 0 ? 'step' : undefined}>
              <button class="hm-how__btn" type="button" data-hub={hub.id}>
                <span class="hm-how__num" aria-hidden="true">{i + 1}<svg viewBox="0 0 32 32" focusable="false"><circle cx="16" cy="16" r="15" pathLength="1" /></svg></span>
                <span class="hm-how__name"><b>{hub.name}</b> {hub.title}</span>
              </button>
              <p class="hm-how__text">{hub.text}</p>
            </li>
          ))}
        </ol>

        <div class="hm-how__links">
          <a class="hm-how__link hm-how__link--acc get-started" href="#demo">Book a demo</a>
          <a class="hm-how__link" href="https://docs.spenza.com/">Read the API docs <span aria-hidden="true">↗</span></a>
        </div>
      </div>

      <div class="hm-how__art" aria-hidden="true">
        <div class="hm-iso">
          {hubs.map((hub, i) => (
            <div class="hm-iso-card" data-hub={hub.id} style={`--i:${i}`}>
              <span class="hm-iso-guide hm-iso-guide--b"></span>
              <span class="hm-iso-guide hm-iso-guide--r"></span>
              <span class="hm-iso-face hm-iso-face--top"></span>
              <span class="hm-iso-face hm-iso-face--side"></span>
              {[0, 1, 2, 3, 4].map(k => <span class="hm-iso-trail" style={`--k:${k}`}></span>)}
              <img src={hub.src} alt="" width="113" height="195" loading="lazy" decoding="async" />
              <span class="hm-iso-tag" data-text={`${hub.n} ${hub.tag}`}>{hub.n} {hub.tag}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
