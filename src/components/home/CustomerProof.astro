---
/**
 * Customer proof: three case studies in a carousel. Design from the Figma file's "Spenza Homepage / Backup"
 * frame; copy is the live site's. Styles in styles/home-sections.css.
 *
 * Every card is in the markup; the carousel (scripts/home.js) only moves them.
 * It advances every six seconds, as the prototype does, and holds while the
 * pointer or focus is inside it or it is off screen.
 */
import arrowNext from '../../assets/home/sz/arrow-next.svg?url';
import arrowPrev from '../../assets/home/sz/arrow-prev.svg?url';
import eyebrowDot from '../../assets/home/sz/eyebrow-dot.svg?url';
import glowBr from '../../assets/home/sz/glow-br.svg?url';
import glowC from '../../assets/home/sz/glow-c.svg?url';
import glowTl from '../../assets/home/sz/glow-tl.svg?url';

const cases = [
  {
    id: 'butlr', mono: 'B', name: 'Butlr', sub: '88% FASTER', seg: 'IoT fleets', kicker: 'SMART BUILDING SENSORS',
    big: '88', unit: '%', word: false,
    desc: 'Faster time to market for a new country, against their previous carrier process.',
    rows: ['New countries launched through their previous carrier process.',
      'High-bandwidth plans for smart building sensors across the US, UK, and France.',
      'All three markets on one invoice, at lower total telecom cost.'],
    quote: 'Multi-country connectivity stopped being an operational burden and became a strategic asset.',
    stats: [['3', 'markets live: US, UK, France'], ['1', 'invoice across every country'], ['Lower', 'total telecom cost']],
    hubs: ['TelecomHub', 'ControlHub'], url: 'https://spenza.com/spenza-product/butlr-iot-spenza-casestudy/',
  },
  {
    id: 'angel-watch', mono: 'AW', name: 'Angel Watch', sub: 'ONE CHECKOUT', seg: 'Connected devices', kicker: "KIDS' SMARTWATCH",
    big: '1', unit: 'checkout', word: true,
    desc: 'For the watch and its connectivity plan, priced for a watch rather than a phone.',
    rows: ["Connectivity for a child's smartwatch, on pricing built around phones.",
      'The plan moved into the Shopify checkout, sold alongside the device.',
      'Watch-priced connectivity, lower cost per line, and a branded activation flow.'],
    quote: 'Connectivity stopped being a cost centre and became a competitive advantage.',
    stats: [['Shopify', 'checkout with device and plan together'], ['Branded', 'activation flow'], ['Lower', 'cost per line']],
    hubs: ['UXHub', 'TelecomHub'], url: 'https://spenza.com/telecom/angel-watch-iot-business-casestudy/',
  },
  {
    id: 'rocketphone', mono: 'RP', name: 'RocketPhone', sub: 'BRANDED MVNO', seg: 'Connectivity providers', kicker: 'CONVERSATION AI FOR SALESFORCE',
    big: '1', unit: 'network', word: true,
    desc: 'A branded business mobile network launched on Spenza, with no telecom stack of their own.',
    rows: ['Calls bypassed RocketPhone and never reached Salesforce.',
      'Carrier integration, eSIM provisioning, billing, and reseller management through one API.',
      'Mobile calls now reach Salesforce with recordings and transcripts.'],
    quote: 'Capturing a native cellular call means controlling the voice path. There is no software shortcut.',
    stats: [['eSIM', 'provisioning and activation over API'], ['SIP', 'termination into their own platform'], ['Multi-tier', 'reseller and enterprise accounts']],
    hubs: ['TelecomHub', 'UXHub'], url: 'https://spenza.com/spenza-product/rocketphone-case-study/',
  },
];
/** Words the design sets at 17px rather than 22px. */
const SMALL = new Set(['Shopify', 'Branded', 'Multi-tier']);
const ROW_LABELS = ['STARTING POINT', 'WHAT MOVED', 'WHAT CHANGED'];

---

<section class="sz-proof" id="customers" aria-labelledby="sz-proof-title" data-fit>
  <div class="sz-proof__bezel" data-fit-box>
    <div class="sz-proof__panel">
      <img class="sz-proof__glow sz-proof__glow--tl" src={glowTl} alt="" aria-hidden="true" />
      <img class="sz-proof__glow sz-proof__glow--c" src={glowC} alt="" aria-hidden="true" />
      <img class="sz-proof__glow sz-proof__glow--br" src={glowBr} alt="" aria-hidden="true" />

      <div class="sz-proof__head">
        <div>
          <p class="sz-proof__eyebrow"><img src={eyebrowDot} alt="" width="6" height="6" />CUSTOMER PROOF</p>
          <h2 class="sz-proof__title" id="sz-proof-title">What changed after<br /><em>they moved to</em> Spenza.</h2>
        </div>
        <div class="sz-proof__intro">
          <p>Three business models, one platform. Each story shows where the team started, what they moved, and what changed.</p>
          <a class="sz-proof__all" href="/category/spenza-product/">All case studies&nbsp; →</a>
        </div>
      </div>

      <div class="sz-car" data-active="0">
        <div class="sz-car__bar">
          <div class="sz-car__tabs" role="tablist" aria-label="Customer stories">
            {cases.map((c, i) => (
              <button class="sz-car__tab" type="button" role="tab" id={`sz-tab-${c.id}`} aria-controls={`sz-case-${c.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
                <span class="sz-car__mono" aria-hidden="true">{c.mono}</span>
                <span class="sz-car__tablabel"><span class="sz-car__tabname">{c.name}</span><span class="sz-car__tabsub">{c.sub}</span></span>
              </button>
            ))}
          </div>
          <div class="sz-car__controls">
            <button class="sz-car__btn sz-car__btn--prev" type="button" aria-label="Previous story"><img src={arrowPrev} alt="" width="18" height="18" /></button>
            <p class="sz-car__count" aria-live="polite"><span class="sz-car__now">01</span>&nbsp; / &nbsp;03</p>
            <button class="sz-car__btn sz-car__btn--next" type="button" aria-label="Next story"><img src={arrowNext} alt="" width="18" height="18" /></button>
          </div>
        </div>
        <div class="sz-car__stage">
          {cases.map((c, i) => (
            <article class:list={['sz-case', { 'is-active': i === 0 }]} id={`sz-case-${c.id}`} role="tabpanel" aria-labelledby={`sz-tab-${c.id}`}>
              <div class="sz-case__main">
                <div class="sz-case__meta"><span class="sz-case__seg">{c.seg}</span><span class="sz-case__kicker">{c.kicker}</span></div>
                <h3 class="sz-case__name">{c.name}</h3>
                <p class="sz-case__big"><b>{c.big}</b><span class:list={[{ 'is-word': c.word }]}>{c.unit}</span></p>
                <p class="sz-case__desc">{c.desc}</p>
                <dl class="sz-case__rows">
                  {c.rows.map((row, k) => <div><dt>{ROW_LABELS[k]}</dt><dd>{row}</dd></div>)}
                </dl>
              </div>
              <div class="sz-case__proof">
                <span class="sz-case__qmark" aria-hidden="true">“</span>
                <blockquote class="sz-case__quote">{c.quote}</blockquote>
                <p class="sz-case__src">—&nbsp; FROM THE {c.name.toUpperCase()} CASE STUDY</p>
                <ul class="sz-case__stats">
                  {c.stats.map(([value, label]) => <li><strong class:list={[{ 'is-sm': SMALL.has(value) }]}>{value}</strong><span>{label}</span></li>)}
                </ul>
                <div class="sz-case__runs"><span>RUNS ON</span><ul>{c.hubs.map(h => <li>{h}</li>)}</ul></div>
                <a class="sz-case__link" href={c.url}>Read the {c.name} story&nbsp; →</a>
              </div>
            </article>
          ))}
          <span class="sz-car__fade sz-car__fade--l" aria-hidden="true"></span>
          <span class="sz-car__fade sz-car__fade--r" aria-hidden="true"></span>
        </div>
      </div>
    </div>
  </div>
</section>
