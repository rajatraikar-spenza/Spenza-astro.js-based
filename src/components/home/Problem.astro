---
/** The connectivity challenge: a sticky intro beside three numbered problems. */
const problems = [
  {
    title: 'Multi-operator connectivity is fragmented',
    text: 'Different operators mean different pricing, APIs, and processes. Managing them separately makes expansion harder and slower.',
  },
  {
    title: 'Connectivity adds a new operational layer',
    text: 'Multiple systems complicate SIM activations, plan changes, usage tracking, and support.',
  },
  {
    title: 'Billing gets complicated fast',
    text: 'Tracking costs and protecting margins become harder with varying operator rates, changes, and customer plan revisions.',
  },
];
---

<section class="hm-sec">
  <div class="hm-wrap">
    <div class="hm-problem hm-stack">
      <div class="hm-problem-intro hm-reveal">
        <div class="hm-eyebrow">THE CONNECTIVITY CHALLENGE</div>
        <h2 class="hm-h2">Add connectivity.<br /> <span class="hm-line">Not telecom overhead.</span></h2>
        <p class="hm-lede">
          Adding connectivity shouldn't mean managing operators, activations, and billing instead of growing your business.
        </p>
      </div>
      <ol class="hm-problem-list">
        {problems.map((problem, i) => (
          <li class="hm-reveal">
            <div class="hm-problem-no">{String(i + 1).padStart(2, '0')}</div>
            <div>
              <h3>{problem.title}</h3>
              <p>{problem.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
