---
/**
 * WordPress' own 301s, mirrored.
 *
 * Slugs have been renamed over the years and the blog content still links to the
 * old URLs; WordPress redirects them to the current article. This catch-all
 * serves the same redirects so those links resolve here too.
 *
 * Generated by `npm run wp:redirects`, which only records a redirect whose
 * target this site actually serves — so a route here can never dead-end.
 *
 * Astro gives named-parameter routes priority over rest parameters, so this
 * never shadows a real page.
 *
 * Superseded by the `_redirects` file the build writes, which gets these served
 * as real 301s. Set `HOST_REDIRECTS=1` once the host is confirmed to honour it
 * and these stand-ins stop being emitted; until then both exist, and the worst
 * case is the meta refresh that was already shipping.
 */
import Redirect from '../components/Redirect.astro';
import wpRedirects from '../data/wp-redirects.json';
import { HOST_REDIRECTS } from '../../scripts/lib/config.mjs';

export async function getStaticPaths() {
  if (HOST_REDIRECTS) return [];

  // WordPress serves both `/contact` and `/contact/`; as a rest param they are
  // the same route, and emitting it twice is a build error.
  const byPath = new Map<string, string>();
  for (const [from, to] of Object.entries(wpRedirects as Record<string, string>)) {
    byPath.set(from.replace(/^\/|\/$/g, ''), to);
  }
  return [...byPath].map(([wpRedirect, target]) => ({
    params: { wpRedirect },
    props: { target },
  }));
}

const { target } = Astro.props;
---

<Redirect to={target} />
