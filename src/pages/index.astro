---
/**
 * The home page: mirrored Elementor markup, with the post carousel rebuilt and
 * the product screenshot replaced.
 *
 * "Latest Telecom Industry Insights" was frozen at whatever was newest when the
 * mirror last ran — on the one section of the site whose job is to show what is
 * newest. Its twelve slides are now rendered from the collection, so a post
 * published in WordPress appears there on the next build.
 *
 * Everything else on the page stays exactly as mirrored.
 */
import WpLayout from '../layouts/WpLayout.astro';
import content from '../partials/index.html?raw';
import { getCollection } from 'astro:content';
import { replaceWidgetInner } from '../../scripts/lib/widget-html.mjs';
import { toMediaOrigin } from '../../scripts/lib/config.mjs';
import { renderHomeCarousel, HOME_CAROUSEL_ID } from '../lib/home-carousel.ts';

/** Matches the twelve the mirrored carousel carried. */
const SLIDES = 12;

const posts = await getCollection('posts');
const newest = [...posts]
  .sort((a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime())
  .slice(0, SLIDES)
  .map(p => p.data);

/**
 * The screenshot in "Run Your Whole Connectivity Business from One Dashboard".
 *
 * Replaced here rather than in the partial for the same reason the carousel is:
 * `src/partials/index.html` is regenerated by `npm run wp:content`, so an edit
 * to it survives only until the next mirror run. Doing it at build time means
 * the new image outlasts a re-mirror, and reverting is deleting this block.
 *
 * The wrapper, its classes and its animation stay as mirrored — only the
 * `<picture>` inside changes — so the purged CSS still styles it.
 *
 * The screenshot lives on the media host, under `wp-content/uploads/`, and is
 * uploaded to the bucket alongside every other image the site serves. An
 * earlier version of this block kept it in `public/images/` instead, reasoning
 * that a file this repo owns should ship with the site; serving it from the
 * media host is the deliberate change, so the page fetches all of its imagery
 * from one origin and this one is not an exception to reason about later. The
 * WebP twins sit under `WEBP_PATH` exactly where the mirror files every other
 * variant, so `toMediaOrigin()` repoints both trees without a special case.
 *
 * Sizes match the ladder WordPress generates: 300, 768, 1024 and 1536 wide
 * plus the 1668px original.
 */
const DASHBOARD_IMAGE_ID = '1440bae';

const DASH_PNG = '/wp-content/uploads/2026/08/connectivity-dashboard';
const DASH_WEBP =
  '/wp-assets/wp-content/webp-express/webp-images/uploads/2026/08/connectivity-dashboard';
const DASH_SIZES = '(max-width: 1024px) 100vw, 1024px';
const DASH_LADDER = [[300, 170], [768, 434], [1024, 579], [1536, 868]];

const srcset = (base: string, suffix: string) =>
  DASH_LADDER.map(([w, h]) => `${base}-${w}x${h}${suffix} ${w}w`)
    .concat(`${base}${suffix} 1668w`)
    .join(', ');

const dashboardImage =
  '<picture>' +
    `<source srcset="${srcset(DASH_WEBP, '.png.webp')}" ` +
      `sizes="${DASH_SIZES}" type="image/webp">` +
    '<img loading="lazy" decoding="async" width="1024" height="579" ' +
      `src="${DASH_PNG}-1024x579.png" class="attachment-large size-large" ` +
      `srcset="${srcset(DASH_PNG, '.png')}" sizes="${DASH_SIZES}" ` +
      'alt="The Spenza dashboard: a subscription\'s plan, status and phone number ' +
      'above 90-day charts of its data, voice and SMS usage">' +
  '</picture>';

/*
 * `toMediaOrigin` by hand, because this markup never meets it otherwise.
 *
 * The partial is rewritten on import by `partial-rewrites-plugin`, but anything
 * injected here is injected afterwards, so its `/wp-content/uploads/` paths stay
 * root-relative. That is silent in a local build — the files are in `public/` —
 * and fatal in a deployed one, where `MEDIA_ORIGIN` drops those trees from
 * `dist` and the browser 404s on every size in the srcset.
 */
let body = replaceWidgetInner(content, HOME_CAROUSEL_ID, renderHomeCarousel(newest));
body = replaceWidgetInner(body, DASHBOARD_IMAGE_ID, toMediaOrigin(dashboardImage));
---

<WpLayout slug="index">
  <Fragment set:html={body} />
</WpLayout>
