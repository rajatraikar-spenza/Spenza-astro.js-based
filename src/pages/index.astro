---
/**
 * The home page.
 *
 * Built in Astro from two sources: the words are the "Spenza Home Final" Figma
 * file's, and the layout, styling and motion are the "Spenza Home v4" HTML
 * design's — except the hero artwork, which stays the "MVNO in a Box"
 * animation. Each section is a component in `components/home/`, styled by
 * `styles/home.css` and made interactive by `scripts/home.js`; there is no
 * framework runtime.
 *
 * It renders through `WpLayout` like /ai-phone-number/ and
 * /voice-observability-solution/, so the header, footer, demo popup, Analytics
 * and lead-capture runtime are the site's own, untouched. There is no partial
 * for `WpLayout` to read, so it is told directly that the page has a Get Started
 * button (the hero's) and no carousel. `public/scripts/page/index.js` still
 * loads — it drives the header's menus and the popup.
 *
 * The CSS optimiser reads these components in place of a partial; see
 * `COMPONENT_PAGES` in scripts/wp-optimize-css.mjs. Read the comment in
 * `ai-phone-number.astro` before re-running it.
 */
import WpLayout from '../layouts/WpLayout.astro';
import Hero from '../components/home/Hero.astro';
import CustomerStrip from '../components/home/CustomerStrip.astro';
import Problem from '../components/home/Problem.astro';
import Segments from '../components/home/Segments.astro';
import Platform from '../components/home/Platform.astro';
import Lifecycle from '../components/home/Lifecycle.astro';
import Comparison from '../components/home/Comparison.astro';
import CustomerProof from '../components/home/CustomerProof.astro';
import Position from '../components/home/Position.astro';
import Faq from '../components/home/Faq.astro';
import FinalCta from '../components/home/FinalCta.astro';
import { HOME_FAQ } from '../data/home-faq';
import '../styles/home.css';

const faq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: HOME_FAQ.map(([name, text]) => ({
    '@type': 'Question',
    name,
    acceptedAnswer: { '@type': 'Answer', text },
  })),
};
---

<WpLayout slug="index" demoPopup swiper={false}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faq)} />
  </Fragment>

  <div class="hm">
    <Hero />
    <CustomerStrip />
    <Problem />
    <Segments />
    <Platform />
    <Lifecycle />
    <Comparison />
    <CustomerProof />
    <Position />
    <Faq />
    <FinalCta />
  </div>
</WpLayout>

<script>
  import '../scripts/home.js';
</script>
