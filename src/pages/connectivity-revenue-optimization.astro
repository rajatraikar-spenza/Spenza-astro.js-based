---
/**
 * /connectivity-revenue-optimization/ — the Voice Observability Solution page
 * (Spenza Number Intelligence).
 *
 * Built the way /ai-phone-number/ is: the body is hand-built, and it renders
 * through `WpLayout` so the site's own header, footer, demo popup, Analytics
 * and lead-capture runtime stay exactly as they are on every other page. The
 * design shipped its own nav bar and footer; neither is used.
 *
 * The URL is kept although the name changed. It replaces the old Connectivity
 * Revenue Optimization page in the Solution menu, and moving it would strand
 * the redirects and post links that already point here. The title,
 * description, Open Graph card and schema name are updated in
 * `data/wp-seo.json`, which is what `WpLayout` emits.
 *
 * `public/scripts/page/connectivity-revenue-optimization.js` is still loaded,
 * and has to be: besides the demo popup it drives the header's mobile
 * submenus. Nothing in it touches this page's own markup.
 *
 * Its CSS bundle was regenerated against this markup (520KB -> 446KB) by
 * running `npm run wp:optimize-css` and keeping only this page's two output
 * files: the page is alone in its bundle group, but a run rewrites every other
 * page's bundle too, and those were restored rather than committed. Read the
 * comment in `ai-phone-number.astro` before doing it again.
 */
import WpLayout from '../layouts/WpLayout.astro';
import content from '../partials/connectivity-revenue-optimization.html?raw';
import '../styles/connectivity-revenue-optimization.css';

/**
 * FAQPage schema, read out of the markup rather than kept as a second copy.
 * Throws if the markup stops matching, so the build fails instead of shipping
 * an empty or stale FAQ graph.
 */
const decode = (s: string) =>
  s
    .replace(/<[^>]+>/g, '')
    .replace(/&rsquo;|&#8217;/g, '’')
    .replace(/&ldquo;/g, '“')
    .replace(/&rdquo;/g, '”')
    .replace(/&mdash;/g, '—')
    .replace(/&middot;/g, '·')
    .replace(/&amp;/g, '&')
    .replace(/\s+/g, ' ')
    .trim();

const questions = [
  ...content.matchAll(/<summary>([\s\S]*?)<\/summary>\s*<div class="ni-ans">([\s\S]*?)<\/div>/g),
].map(([, name, text]) => ({
  '@type': 'Question',
  name: decode(name),
  acceptedAnswer: { '@type': 'Answer', text: decode(text) },
}));

if (questions.length === 0) {
  throw new Error('connectivity-revenue-optimization: no FAQ items found in the partial');
}

const faq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: questions,
};
---

<WpLayout slug="connectivity-revenue-optimization">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faq)} />
  </Fragment>

  <Fragment set:html={content} />
</WpLayout>
