---
/**
 * /blog/guest-blogs/ — articles by guest authors (category "guest-blogs").
 *
 * Each card carries the author's photo, name, designation and company (set in
 * the admin under Settings > Authors), the date, the headline and the opening
 * of the piece; "Read more" opens the full article, at /guest-blogs/<slug>/, in
 * a new tab. Paginated at /blog/guest-blogs/page/2/.
 *
 * Renders through WpLayout for the site's header and footer, with the hubs'
 * stylesheet pair (see `wp-css-bundles.json`).
 */
import { getCollection } from 'astro:content';
import WpLayout from '../../../layouts/WpLayout.astro';
import GuestCard from '../../../components/guest-blogs/GuestCard.astro';
import TAGS from '../../../content/cms-meta/tags.json';
import '../../../styles/hub.css';
import '../../../styles/guest-blogs.css';

export async function getStaticPaths() {
  const PER_PAGE = 10;
  const all = (await getCollection('posts'))
    .filter(p => p.data.category === 'guest-blogs')
    .sort((a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime());
  const totalPages = Math.max(1, Math.ceil(all.length / PER_PAGE));
  return Array.from({ length: totalPages }, (_, i) => ({
    params: { page: i === 0 ? undefined : `page/${i + 1}` },
    props: { page: i + 1, totalPages, total: all.length, posts: all.slice(i * PER_PAGE, (i + 1) * PER_PAGE), recent: all.slice(0, 5), all },
  }));
}

const { page, totalPages, total, posts, recent, all } = Astro.props;
const BASE = '/blog/guest-blogs/';
const pageHref = (n: number) => (n === 1 ? BASE : `${BASE}page/${n}/`);

const tagLabels: Record<string, string> = Object.fromEntries(TAGS.tags.map(t => [t.slug, t.label]));
const topicCount = new Map<string, number>();
for (const p of all) for (const t of p.data.tags) topicCount.set(t, (topicCount.get(t) ?? 0) + 1);
const topics = [...topicCount].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0])).slice(0, 12);
const authorCount = new Set(all.map(p => p.data.author?.slug)).size;

const title = page === 1 ? 'Guest Blogs - Spenza' : `Guest Blogs - Page ${page} - Spenza`;
const description = 'Guest articles on MVNOs, IoT, eSIM and telecom, written by the operators, vendors and analysts who work in the industry.';
---

<WpLayout slug="guest-blogs" title={title} description={description} demoPopup={false} swiper={false}>
  <div class="ux gb" id="guest-blogs">
    <section class="gb-hero">
      <div class="gb-wrap">
        <p class="gb-eyebrow">Guest Blogs</p>
        <h1>Voices from across the <em>telecom</em> industry</h1>
        <p class="gb-lede">Independent perspectives on MVNOs, IoT, eSIM and connectivity, written by the people who build, run and analyse them.</p>
        <p class="gb-stats">
          <span><b>{total}</b> {total === 1 ? 'article' : 'articles'}</span>
          <span><b>{authorCount}</b> {authorCount === 1 ? 'contributor' : 'contributors'}</span>
        </p>
      </div>
    </section>

    <div class="gb-wrap gb-layout">
      <main class="gb-list">
        {posts.length
          ? posts.map(p => <GuestCard post={p} tagLabels={tagLabels} />)
          : <p class="gb-empty">No guest articles yet. Check back soon.</p>}

        {totalPages > 1 && (
          <nav class="gb-pages" aria-label="Guest blog pages">
            {page > 1 && <a href={pageHref(page - 1)} rel="prev">← Newer</a>}
            {Array.from({ length: totalPages }, (_, i) => i + 1).map(n =>
              n === page
                ? <span aria-current="page">{n}</span>
                : <a href={pageHref(n)}>{n}</a>)}
            {page < totalPages && <a href={pageHref(page + 1)} rel="next">Older →</a>}
          </nav>
        )}
      </main>

      <aside class="gb-side" aria-label="Guest blog sidebar">
        {recent.length > 0 && (
          <section class="gb-box">
            <h2>Recent posts</h2>
            <ul>
              {recent.map(p => (
                <li><a href={`/${p.data.category}/${p.data.slug}/`} target="_blank" rel="noopener">{p.data.title}</a>
                  {p.data.author && <span>{p.data.author.name}</span>}</li>
              ))}
            </ul>
          </section>
        )}
        {topics.length > 0 && (
          <section class="gb-box">
            <h2>Topics</h2>
            <ul class="gb-topics">
              {topics.map(([slug, n]) => <li><a href={`/tag/${slug}/`}>{tagLabels[slug] ?? slug} <small>{n}</small></a></li>)}
            </ul>
          </section>
        )}
        <section class="gb-box gb-cta">
          <h2>Write for Spenza</h2>
          <p>Work in telecom, IoT or connectivity and have something to say? We publish guest articles from practitioners.</p>
          <a class="gb-btn" href="/contact-us/">Get in touch</a>
        </section>
      </aside>
    </div>
  </div>
</WpLayout>
