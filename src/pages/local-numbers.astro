    title: 'Banks & Financial Services',
    sub: 'Get OTPs and verification messages through',
    text: 'Bank-linked mobile flows often apply strict anti-fraud checks. VoIP ranges can be filtered, while US MNO-backed numbers carry stronger mobile-network trust signals.',
  },
  {
    icon: '<path d="M12 3l8 4v5c0 5-3.4 8.2-8 9-4.6-.8-8-4-8-9V7l8-4Z"/><path d="M9 12l2 2 4-4"/>',
    title: 'Government & Federal Portals',
    sub: 'Work with verification-sensitive services',
    text: 'Government identity and verification flows may require a recognized US mobile number. MNO-backed numbers are better aligned with those requirements than standard VoIP DIDs.',
  },
  {
    icon: '<rect x="4" y="10" width="16" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/><path d="M12 14v3"/>',
    title: 'Enterprise SaaS & CRM Inboxes',
    sub: 'Avoid shared VoIP reputation issues',
    text: 'Enterprise platforms can use carrier and reputation data to filter inbound SMS. Dedicated mobile operator-backed numbers avoid the reputation risks of shared VoIP ranges.',
  },
  {
    icon: '<path d="M4 19v-4"/><path d="M9 19v-8"/><path d="M14 19V7"/><path d="M19 19V4"/>',
    title: 'Mobile Operators & A2P Firewalls',
    sub: 'Pass carrier-level trust checks',
    text: 'US operators enforce messaging and identity controls at the network level. MNO-backed numbers originate from mobile-network infrastructure rather than a VoIP layer.',
  },
];

const ownership = [
  {
    icon: '<circle cx="8" cy="15" r="4.5"/><path d="M11.2 11.8 20 3"/><path d="M17 6l3 3"/><path d="M14.5 8.5l2 2"/>',
    title: 'You own the number',
    sub: 'Dedicated to your account',
