<script>
  /* ── Delivery simulation ──────────────────────────────────────────
     The design's canvas animation, with four changes:
       - the bitmap is sized from the card at the device's pixel ratio, so
         it is sharp on a retina screen and its labels stay legible on a
         phone instead of being scaled down with a fixed 560px drawing;
       - movement is timed by the clock, not by frames, so a 120Hz screen
         does not run it twice as fast;
       - it stops drawing while off screen or in a background tab;
       - with reduced motion it draws one still frame. */
  const canvas = document.getElementById('ln-signal') as HTMLCanvasElement | null;
  const ctx = canvas?.getContext('2d');

  if (canvas && ctx) {
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const COL = {
      ink: '#0f1420',
      muted: '#5b6472',
      line: '#e6e1d8',
      voip: '#8a93a3',
      voipDeep: '#57534e',
      voipBg: '#f6f4ef',
      voipPill: '#eceae4',
      mno: '#ff4904',
      mnoDeep: '#c2410c',
      mnoBg: '#fff2ed',
      mnoPill: '#ffe3d6',
    };
    const SANS = 'Geist, system-ui, sans-serif';
    const PERIOD = 1.5; // seconds between VoIP sends; two MNO sends in between

    type Packet = { lane: 'voip' | 'mno'; x: number };
    let W = 560, H = 320, MID = 160;
    let lane = { voip: 80, mno: 240 };
    let nodes = { sender: 72, carrier: 280, dest: 488 };
    let speed = 84; // px per second at 560 wide, as the design moved
    let packets: Packet[] = [];
    let clock = 0;
    let last = 0;
    let running = false;
    let visible = false;

    function layout() {
      W = Math.max(280, Math.round(canvas!.clientWidth || 560));
      // Narrow cards get a taller drawing, so the lanes' labels have room.
      // The CSS reserves the same box with a container query, so nothing
      // moves when this runs; keep the 480 and 340 in step with it.
      H = W >= 480 ? Math.round((W * 320) / 560) : 340;
      MID = H / 2;
      const inset = Math.max(46, Math.round(W * 0.128));
      nodes = { sender: inset, carrier: W / 2, dest: W - inset };
      const laneOffset = Math.max(MID * 0.5, 70);
      lane = { voip: laneOffset, mno: MID + laneOffset };
      speed = (84 * W) / 560;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas!.width = Math.round(W * dpr);
      canvas!.height = Math.round(H * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function roundRect(x: number, y: number, w: number, h: number, r: number) {
      ctx!.beginPath();
      // Safari before 16 has no roundRect; the arcs below draw the same shape.
      if ('roundRect' in ctx!) {
        ctx!.roundRect(x, y, w, h, r);
      } else {
        ctx!.moveTo(x + r, y);
        ctx!.arcTo(x + w, y, x + w, y + h, r);
        ctx!.arcTo(x + w, y + h, x, y + h, r);
        ctx!.arcTo(x, y + h, x, y, r);
        ctx!.arcTo(x, y, x + w, y, r);
        ctx!.closePath();
      }
    }

    function pill(text: string, cx: number, cy: number, fg: string, bg: string, align: 'center' | 'left' = 'center') {
      ctx!.font = `700 12px ${SANS}`;
      const pw = ctx!.measureText(text).width + 18;
      const px = align === 'left' ? cx : cx - pw / 2;
      ctx!.fillStyle = bg;
      roundRect(px, cy - 11, pw, 22, 11);
      ctx!.fill();
      ctx!.fillStyle = fg;
      ctx!.textAlign = 'center';
      ctx!.textBaseline = 'middle';
      ctx!.fillText(text, px + pw / 2, cy);
      return px + pw;
    }

    function node(x: number, y: number, color: string) {
      ctx!.strokeStyle = color;
      ctx!.lineWidth = 2;
      ctx!.fillStyle = '#fff';
      ctx!.beginPath();
      ctx!.arc(x, y, 10, 0, Math.PI * 2);
      ctx!.fill();
      ctx!.stroke();
      ctx!.fillStyle = color;
      ctx!.beginPath();
      ctx!.arc(x, y, 4, 0, Math.PI * 2);
      ctx!.fill();
    }

    function label(x: number, y: number, lines: string[], color: string) {
      ctx!.textAlign = 'center';
      ctx!.textBaseline = 'top';
      lines.forEach((l, i) => {
        ctx!.fillStyle = i === 0 ? color : COL.muted;
        ctx!.font = i === 0 ? `600 11px ${SANS}` : `500 10px ${SANS}`;
        ctx!.fillText(l, x, y + 14 + i * 13);
      });
    }

    function dashed(y: number, color: string) {
      ctx!.strokeStyle = color + '55';
      ctx!.lineWidth = 1.5;
      ctx!.setLineDash([5, 6]);
      ctx!.beginPath();
      ctx!.moveTo(nodes.sender + 12, y);
      ctx!.lineTo(nodes.dest - 12, y);
      ctx!.stroke();
      ctx!.setLineDash([]);
    }

    function blockX(x: number, y: number) {
      ctx!.fillStyle = COL.voipPill;
      ctx!.beginPath();
      ctx!.arc(x, y, 14, 0, Math.PI * 2);
      ctx!.fill();
      ctx!.strokeStyle = COL.voipDeep;
      ctx!.lineWidth = 2.5;
      ctx!.beginPath();
      ctx!.moveTo(x - 6, y - 6);
      ctx!.lineTo(x + 6, y + 6);
      ctx!.moveTo(x + 6, y - 6);
      ctx!.lineTo(x - 6, y + 6);
      ctx!.stroke();
    }

    function packet(p: Packet) {
      const y = lane[p.lane];
      const color = p.lane === 'voip' ? COL.voip : COL.mno;
      const grad = ctx!.createLinearGradient(p.x - 36, y, p.x, y);
      grad.addColorStop(0, 'rgba(255,255,255,0)');
      grad.addColorStop(1, color + 'BB');
      ctx!.strokeStyle = grad;
      ctx!.lineWidth = 2;
      ctx!.beginPath();
      ctx!.moveTo(p.x - 36, y);
      ctx!.lineTo(p.x, y);
      ctx!.stroke();
      ctx!.fillStyle = color;
      ctx!.beginPath();
      ctx!.moveTo(p.x + 11, y);
      ctx!.lineTo(p.x, y - 7);
      ctx!.lineTo(p.x + 3, y);
      ctx!.lineTo(p.x, y + 7);
      ctx!.closePath();
      ctx!.fill();
    }

    function frame() {
      ctx!.clearRect(0, 0, W, H);
      ctx!.fillStyle = COL.voipBg;
      ctx!.fillRect(0, 0, W, MID);
      ctx!.fillStyle = COL.mnoBg;
      ctx!.fillRect(0, MID, W, MID);
      ctx!.strokeStyle = COL.line;
      ctx!.lineWidth = 1;
      ctx!.beginPath();
      ctx!.moveTo(0, MID);
      ctx!.lineTo(W, MID);
      ctx!.stroke();

      const left = Math.max(10, nodes.sender - 46);
      const endVoip = pill('VoIP DID', left, 18, COL.voipDeep, COL.voipPill, 'left');
      const endMno = pill('Spenza MNO', left, MID + 18, COL.mnoDeep, COL.mnoPill, 'left');
      ctx!.font = `500 11px ${SANS}`;
      ctx!.textAlign = 'left';
      ctx!.textBaseline = 'middle';
      ctx!.fillStyle = COL.voipDeep;
      ctx!.fillText('Twilio · UCaaS · CRM', Math.max(endVoip, endMno) + 10, 18);
      ctx!.fillStyle = COL.mnoDeep;
      ctx!.fillText('Wholesale MNO contract', Math.max(endVoip, endMno) + 10, MID + 18);

      dashed(lane.voip, COL.voip);
      dashed(lane.mno, COL.mno);
      for (const x of [nodes.sender, nodes.carrier, nodes.dest]) {
        node(x, lane.voip, COL.voip);
        node(x, lane.mno, COL.mno);
      }
      blockX(nodes.carrier, lane.voip);

      label(nodes.sender, lane.voip, ['Your App'], COL.ink);
      label(nodes.sender, lane.mno, ['Your App'], COL.ink);
      label(nodes.carrier, lane.voip, ['Carrier', 'Firewall'], COL.voipDeep);
      label(nodes.carrier, lane.mno, ['Carrier', 'Firewall'], COL.mnoDeep);
      label(nodes.dest, lane.voip, ['BLOCKED'], COL.voipDeep);
      label(nodes.dest, lane.mno, ['DELIVERED'], COL.mnoDeep);

      pill('✕  Blocked', nodes.dest, lane.voip - 26, COL.voipDeep, COL.voipPill);
      pill('✓  Delivered', nodes.dest, lane.mno - 26, COL.mnoDeep, COL.mnoPill);

      packets.forEach(packet);
    }

    function spawn(laneName: Packet['lane'], x = nodes.sender + 20) {
      packets.push({ lane: laneName, x });
    }

    function tick(now: number) {
      if (!running) return;
      const dt = Math.min((now - (last || now)) / 1000, 0.1);
      last = now;
      const before = clock % PERIOD;
      clock += dt;
      const after = clock % PERIOD;
      // Fire each send once as the clock passes its offset in the period.
      const crossed = (at: number) => (after < before ? at >= before || at < after : at >= before && at < after);
      if (crossed(0)) spawn('voip');
      if (crossed(PERIOD * 0.311)) spawn('mno');
      if (crossed(PERIOD * 0.622)) spawn('mno');

      const blockAt = nodes.carrier - 18;
      packets = packets.filter(p => (p.lane === 'voip' ? p.x < blockAt : p.x < W + 40));
      packets.forEach(p => (p.x += speed * dt));
      frame();
      requestAnimationFrame(tick);
    }

    function start() {
      if (running || reduceMotion || !visible || document.hidden) return;
      running = true;
      last = 0;
      requestAnimationFrame(tick);
    }

    function stop() {
      running = false;
    }

    function still() {
      packets = [];
      spawn('voip', nodes.sender + (nodes.carrier - nodes.sender) * 0.4);
      spawn('mno', nodes.sender + (nodes.carrier - nodes.sender) * 0.7);
      spawn('mno', nodes.dest - 60);
      frame();
    }

    // Phones hide the card, so nothing is drawn until it has a size — the
    // ResizeObserver below catches it if the window is widened later.
    const shown = () => canvas.clientWidth > 0;
    if (shown()) {
      layout();
      if (reduceMotion) still();
      else {
        spawn('voip');
        frame();
      }
    }

    let resizeTimer = 0;
    new ResizeObserver(() => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        if (!shown()) return;
        const was = W;
        layout();
        if (W !== was) packets = packets.map(p => ({ ...p, x: (p.x * W) / was }));
        if (reduceMotion) still();
        else frame();
      }, 100);
    }).observe(canvas);

    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible) start();
      else stop();
    }).observe(canvas);

    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));

    // The canvas draws text; redraw once the webfont it names has arrived.
    document.fonts?.ready.then(() => shown() && (reduceMotion ? still() : frame()));
  }

  /* ── API example tabs ─────────────────────────────────────────── */
  const tablist = document.querySelector<HTMLElement>('.ln-code-tabs');
  if (tablist) {
    const tabs = [...tablist.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (tab: HTMLButtonElement, focus = false) => {
      for (const t of tabs) {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(t.getAttribute('aria-controls')!);
        if (panel) panel.hidden = !on;
      }
      if (focus) tab.focus();
    };
    tablist.addEventListener('click', e => {
      const tab = (e.target as HTMLElement).closest<HTMLButtonElement>('[role="tab"]');
      if (tab) select(tab);
    });
    tablist.addEventListener('keydown', e => {
      const i = tabs.indexOf(document.activeElement as HTMLButtonElement);
      if (i < 0) return;
      const next =
        e.key === 'ArrowRight' ? tabs[(i + 1) % tabs.length]
        : e.key === 'ArrowLeft' ? tabs[(i - 1 + tabs.length) % tabs.length]
        : e.key === 'Home' ? tabs[0]
        : e.key === 'End' ? tabs[tabs.length - 1]
        : null;
      if (next) {
        e.preventDefault();
        select(next, true);
      }
    });
  }
</script>
