---
/**
 * Layout for pages mirrored from WordPress.
 *
 * Loads the exact stylesheet set the live page loaded (order matters — the
 * Elementor cascade depends on it), the extracted inline head CSS, and the
 * mirrored Elementor header/footer templates. Elementor's jQuery runtime is
 * replaced by /scripts/wp-shim.js.
 */
import wpStyles from '../data/wp-styles.json';
import wpInlineStyles from '../data/wp-inline-styles.json';
import wpPages from '../data/wp-pages.json';
import wpScripts from '../data/wp-scripts.json';
import wpCssBundles from '../data/wp-css-bundles.json';
import wpSeo from '../data/wp-seo.json';
import headerHtml from '../partials/chrome/header.html?raw';
import footerHtml from '../partials/chrome/footer.html?raw';
import { MEDIA_ORIGIN, NOINDEX } from '../../scripts/lib/config.mjs';
import { rewriteHead, withoutTitle, titleFrom } from '../../scripts/lib/wp-head.mjs';
import '../styles/wp-polish.css';

interface Props {
  /** Key into the mirrored data files — the page slug, or "index" for home. */
  slug: string;
  title?: string;
  description?: string;
  /**
   * Whether this route is a real, indexable page.
   *
   * The 404 page borrows another page's slug for its stylesheet set, which also
   * handed it that page's Yoast head — so `dist/404.html` declared itself
   * canonical for `/sub-processors/`. A 404 claiming to be a real page is worse
   * than a 404 with no metadata at all.
   */
  indexable?: boolean;
}

const { slug, title, description, indexable = true } = Astro.props;

type PageMeta = { id?: string; title: string; description: string; bodyClass: string };

const meta = (wpPages as Record<string, PageMeta>)[slug];

/**
 * Purged, minified bundles replacing the ~61 stylesheets WordPress served,
 * generated by `npm run wp:optimize-css`: a shared bundle every page in its
 * group reuses, then this page's own inline CSS. That order reproduces the
 * original cascade, since the inline block was always emitted last.
 *
 * Falls back to the original ordered list when a page has no bundle — the
 * optimiser deliberately skips anything it cannot analyse, and a page with
 * unoptimised CSS is fine where a page with missing CSS is not.
 */
const bundle: string[] | undefined = (wpCssBundles as Record<string, string[]>)[slug];
const styles: string[] = bundle ?? (wpStyles as Record<string, string[]>)[slug] ?? [];
const inlineStyle: string | undefined = bundle
  ? undefined
  : (wpInlineStyles as Record<string, string>)[slug];

// The site's own behaviour scripts (tabs, case-study cards, popups) plus any
// structured data the page carried.
const pageScripts = (wpScripts as Record<string, { script: string | null; jsonLd: string[] }>)[slug];

// Astra/Elementor selectors depend on these, so mirror them verbatim.
const bodyClass = ['wp-mirror', meta?.bodyClass ?? 'elementor-default elementor-kit-56']
  .filter(Boolean)
  .join(' ');

/**
 * Yoast's own `<head>`, captured by `npm run wp:seo` and repointed at this site.
 *
 * Emitted verbatim for the same reason ArticleLayout does it for posts: what
 * WordPress serves is the reference, and rebuilding it by hand loses the parts
 * that are easy to forget — og:image and its dimensions, og:locale,
 * og:site_name, Twitter's data labels, and the whole JSON-LD graph. Those were
 * all missing from the hand-built tags below, on every marketing page.
 *
 * Stored as WordPress emitted it and repointed here, not at capture time —
 * otherwise the canonical is fixed to whichever SITE_URL generated the file.
 *
 * The fallback stays: a page with no capture keeps the original tags rather
 * than losing its description and canonical entirely.
 */
const captured = indexable ? (wpSeo as Record<string, string>)[slug] : undefined;
const seoHead: string | undefined = captured ? rewriteHead(captured) : undefined;

const pageTitle = title ?? titleFrom(seoHead) ?? meta?.title ?? 'Spenza';
const pageDescription = description ?? meta?.description ?? '';
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico?v=2" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>

    {/*
      Yoast's block carries the description, canonical, Open Graph, Twitter and
      JSON-LD. Its <title> is stripped so it cannot compete with the one above —
      a duplicate title is worse than a missing tag, because which one wins is
      undefined.
    */}
    {seoHead
      ? <Fragment set:html={withoutTitle(seoHead)} />
      : (
        <>
          {pageDescription && <meta name="description" content={pageDescription} />}
          <link rel="canonical" href={canonical} />
          <meta property="og:type" content="website" />
          <meta property="og:url" content={canonical} />
          <meta property="og:title" content={pageTitle} />
          {pageDescription && <meta property="og:description" content={pageDescription} />}
          <meta name="twitter:card" content="summary_large_image" />
        </>
      )}

    {/* Yoast emits index,follow; a staging build and a 404 must override it. */}
    {(NOINDEX || !indexable) && <meta name="robots" content="noindex, nofollow" />}

    {/*
      No preconnect to fonts.googleapis.com / fonts.gstatic.com: `npm run wp:fonts`
      mirrors those stylesheets and their woff2 into /wp-assets/_fonts/, so
      nothing on the page reaches Google. A preconnect to a host the page never
      contacts costs a speculative DNS lookup and TLS handshake for nothing.
    */}
    {/*
      Deliberately without `crossorigin`: it opens the connection in CORS mode,
      and a plain `<img>` or `<video>` request — which is all this origin serves
      — cannot reuse one, so the hint would warm a connection nothing then uses.
    */}
    {MEDIA_ORIGIN && <link rel="preconnect" href={MEDIA_ORIGIN} />}

    {styles.map(href => <link rel="stylesheet" href={href} />)}
    {inlineStyle && <link rel="stylesheet" href={inlineStyle} />}

    {pageScripts?.jsonLd?.map(json => (
      <script type="application/ld+json" set:html={json} />
    ))}

    <script src="/wp-assets/wp-content/plugins/elementor/assets/lib/swiper/v8/swiper.min.js" defer></script>
    <script src="/scripts/wp-shim.js" defer></script>
    {pageScripts?.script && <script src={pageScripts.script} defer></script>}

    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link screen-reader-text" href="#wp-main">Skip to content</a>

    <Fragment set:html={headerHtml} />

    <main id="wp-main">
      <slot />
    </main>

    <Fragment set:html={footerHtml} />
  </body>
</html>
