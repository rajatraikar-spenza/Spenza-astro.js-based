---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import '../styles/global.css';
import googleFonts from '../data/wp-google-fonts.json';

/** The one Google Fonts request this layout makes; mirrored by `npm run wp:fonts`. */
const FONT_CSS = 'https://fonts.googleapis.com/css2?family=Lexend+Deca:wght@300;400;500;600;700&family=Manrope:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap';


interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  type?: string;
}

const {
  title = 'Spenza | Modern Spend Management & Business Solutions',
  description = 'Spenza provides intelligent financial management, spend controls, and automated expense workflows for growing enterprises.',
  image = '/og-image.png',
  canonicalUrl = Astro.url.href,
  type = 'website',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url)} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.url)} />

    {/*
      This layout renders the hand-built rebuild experiment, not the mirrored
      site — keep it out of the index. It was being listed in sitemap.xml and
      would have been submitted to Google as though it were a real page.
    */}
    <meta name="robots" content="noindex, nofollow" />

    {/*
      Matches the live site's stack: Lexend Deca body, Manrope/Inter support.
      Headings ask for proxima-nova first, which WordPress never actually
      serves, so Manrope carries the fallback here.

      Served from this origin — `npm run wp:fonts` mirrors the stylesheet and
      its woff2 — so there is no preconnect to Google's two hosts either.
    */}
    <link rel="stylesheet" href={googleFonts[FONT_CSS] ?? FONT_CSS} />

    <slot name="head" />
  </head>
  <body>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
