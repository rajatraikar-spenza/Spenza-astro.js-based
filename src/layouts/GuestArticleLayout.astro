---
/**
 * A guest article at /guest-blogs/<slug>/.
 *
 * Laid out like the reference guest-blog sites do: a reading strip (time, words,
 * share), the title with the author's photo beside it and a byline of name, date
 * and category, then the article, then an "About the author" card (designation,
 * company, LinkedIn, all their articles) and the author's latest pieces. The
 * sidebar matches the guest list. Header, footer and the head (title, meta,
 * schema) are the site's, via WpLayout.
 */
import type { CollectionEntry } from 'astro:content';
import WpLayout from './WpLayout.astro';
import GuestPostingModal from '../components/guest-blogs/GuestPostingModal.astro';
import GuestSidebar from '../components/guest-blogs/GuestSidebar.astro';
import { categoryLabel } from '../data/blog-categories.ts';
import { guestPosts, topicsOf, tagLabels, plainText } from '../lib/guest-blogs.ts';
import '../styles/guest-blogs.css';

interface Props { post: CollectionEntry<'posts'> }
const { post } = Astro.props;
const d = post.data;
const a = d.author;

const all = await guestPosts();
const recent = all.slice(0, 5);
const topics = topicsOf(all);
const mine = a ? all.filter(p => p.data.author?.slug === a.slug) : [];
const more = mine.filter(p => p.data.slug !== d.slug).slice(0, 3);

const words = plainText(d.content).split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.ceil(words / 200));
const DATE = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
const DATE_LONG = new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
const initials = (n: string) => n.split(/\s+/).filter(Boolean).slice(0, 2).map(w => w[0]).join('').toUpperCase();
const teaser = (p: CollectionEntry<'posts'>) => {
  const t = plainText(p.data.content);
  const src = t.length > 80 ? t : plainText(p.data.excerpt);
  return src.length <= 130 ? src : src.slice(0, src.lastIndexOf(' ', 130)).trimEnd() + '…';
};

const url = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
const enc = encodeURIComponent;
const share = {
  linkedin: `https://www.linkedin.com/sharing/share-offsite/?url=${enc(url)}`,
  facebook: `https://www.facebook.com/sharer/sharer.php?u=${enc(url)}`,
  x: `https://x.com/intent/post?url=${enc(url)}&text=${enc(d.title)}`,
  whatsapp: `https://api.whatsapp.com/send?text=${enc(d.title + ' ' + url)}`,
};
---

<WpLayout slug="archive-category-telecom" title={d.seo.title} description={d.seo.description} headHtml={d.seo.fullHead || undefined}>
  <div class="gb gb-article">
    <nav class="gb-crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a><span aria-hidden="true">›</span>
      <a href="/blog/">Blog</a><span aria-hidden="true">›</span>
      <a href="/blog/guest-blogs/">Guest Blogs</a>
    </nav>

    <div class="gb-layout">
      <article class="gb-main">
        <div class="gb-strip">
          <span>{minutes} min read</span>
          <span>{words.toLocaleString('en-US')} words</span>
          <span class="gb-share">Share
            <a href={share.facebook} target="_blank" rel="noopener" aria-label="Share on Facebook" title="Facebook"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M24 12a12 12 0 1 0-13.9 11.9v-8.4H7.1V12h3V9.4c0-3 1.8-4.7 4.5-4.7 1.3 0 2.7.2 2.7.2v3h-1.5c-1.5 0-2 .9-2 1.9V12h3.4l-.5 3.5h-2.9v8.4A12 12 0 0 0 24 12z"/></svg></a>
            <a href={share.x} target="_blank" rel="noopener" aria-label="Share on X" title="X"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.2 2.3h3.3l-7.2 8.3 8.5 11.2h-6.7l-5.2-6.8-6 6.8H1.6l7.7-8.8L1.2 2.3H8l4.7 6.2zm-1.2 17.5h1.8L7.1 4.2H5.1z"/></svg></a>
            <a href={share.linkedin} target="_blank" rel="noopener" aria-label="Share on LinkedIn" title="LinkedIn"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.4 20.5h-3.6v-5.6c0-1.3 0-3-1.8-3s-2.1 1.4-2.1 2.9v5.7H9.4V9h3.4v1.6h.1c.5-.9 1.6-1.8 3.4-1.8 3.6 0 4.3 2.4 4.3 5.5zM5.3 7.4a2.1 2.1 0 1 1 0-4.1 2.1 2.1 0 0 1 0 4.1zM7.1 20.5H3.6V9h3.5zM22.2 0H1.8C.8 0 0 .8 0 1.7v20.6c0 .9.8 1.7 1.8 1.7h20.4c1 0 1.8-.8 1.8-1.7V1.7C24 .8 23.2 0 22.2 0z"/></svg></a>
            <a href={share.whatsapp} target="_blank" rel="noopener" aria-label="Share on WhatsApp" title="WhatsApp"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.5 14.4c-.3-.1-1.8-.9-2-1-.3-.1-.5-.1-.7.1l-.9 1.1c-.2.2-.3.2-.6.1-1.7-.8-2.8-1.5-3.9-3.3-.3-.5.3-.5.8-1.6.1-.2 0-.4 0-.5l-.9-2.1c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.4s1 2.8 1.2 3c.1.2 2 3.1 4.9 4.3 1.8.8 2.5.9 3.4.7.6-.1 1.8-.7 2-1.4.3-.7.3-1.3.2-1.4-.1-.2-.3-.2-.6-.4zM12 21.8a9.8 9.8 0 0 1-5-1.4l-.4-.2-3.700 1 1-3.600-.2-.4A9.800 9.800 0 1 1 12 21.800zM12 0A12 12 0 0 0 1.700 18L0 24l6.200-1.600A12 12 0 1 0 12 0z"/></svg></a>
          </span>
        </div>

        <header class="gb-head">
          {a && (
            <span class="gb-avatar gb-avatar--lg">
              {a.avatar ? <img src={a.avatar} alt="" width="88" height="88" /> : <span aria-hidden="true">{initials(a.name)}</span>}
            </span>
          )}
          <div>
            <h1>{d.title}</h1>
            <p class="gb-byline">
              {a && <>by <b class="gb-byline__name">{a.name}</b></>}
              {(a?.role || a?.company) && <><i>|</i><span class="gb-byline__role">{[a?.role, a?.company].filter(Boolean).join(', ')}</span></>}
              <i>|</i><time datetime={d.publishedDate.toISOString()}>{DATE.format(d.publishedDate)}</time>
            </p>
          </div>
        </header>

        <div class="gb-prose" set:html={d.content} />

        {a && (
          <section class="gb-author" aria-label="About the author">
            {a.avatar
              ? <img class="gb-author__photo" src={a.avatar} alt={`Picture of ${a.name}`} width="96" height="96" loading="lazy" />
              : <span class="gb-author__photo gb-author__photo--init" aria-hidden="true">{initials(a.name)}</span>}
            <div>
              <p class="gb-eyebrow">About the author</p>
              <h2>{a.name}</h2>
              {(a.role || a.company) && (
                <p class="gb-author__role">{a.role && <b>{a.role}</b>}{a.role && a.company && ' · '}{a.company}</p>
              )}
              {a.bio && <p class="gb-author__bio">{a.bio}</p>}
              <p class="gb-author__links">
                {a.linkedin && <a href={a.linkedin} target="_blank" rel="noopener">LinkedIn →</a>}
              </p>
            </div>
          </section>
        )}

        {a && more.length > 0 && (
          <section class="gb-more-by" aria-label={`Latest from ${a.name}`}>
            <div class="gb-more-by__head">
              <h2>Latest from {a.name}</h2>
            </div>
            <div class="gb-more-by__grid">
              {more.map(p => (
                <a class="gb-mini" href={`/${p.data.category}/${p.data.slug}/`}>
                  <time datetime={p.data.publishedDate.toISOString()}>{DATE_LONG.format(p.data.publishedDate)}</time>
                  <b>{p.data.title}</b>
                  <span>{teaser(p)}</span>
                </a>
              ))}
            </div>
          </section>
        )}
      </article>

      <GuestSidebar recent={recent} topics={topics} tagLabels={tagLabels} />
    </div>
  </div>
  <GuestPostingModal />
</WpLayout>
