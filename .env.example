# Copy to .env and adjust. Defaults reproduce the pre-P1 behaviour, so an
# absent .env changes nothing.

# The WordPress instance content is mirrored and queried from.
WP_ORIGIN=https://preprod.spenza.com

# Canonical origin of the public site. Drives canonicals and the sitemap.
SITE_URL=https://spenza.com

# Where blog/case-study media is served from in the built site.
#
# Leave empty to serve media out of this repo (the state until the media host
# exists). Must NOT be the WP_ORIGIN host: preprod serves "Disallow: /", so
# images hosted there would be uncrawlable — config.mjs rejects that outright.
# MEDIA_ORIGIN=https://media.spenza.com
