# Copy to .env and adjust. Every value below has a default that reproduces
# production, so an absent .env builds the production site.

# The WordPress instance content is mirrored and queried from.
WP_ORIGIN=https://preprod.spenza.com

# Where the browser replays a form submission so Gravity Forms sends the
# emails it has always sent: the "thanks for contacting Spenza" reply to the
# submitter, and the alert to sales. Thirteen notifications across the six
# forms; form 20 alone has seven, picked by the solution dropdown. HubSpot
# never sent any of them — the six targets are *collected* forms, which have no
# follow-up email to configure — so posting to HubSpot alone captures the lead
# and mails nobody.
#
# Empty by default. Turning it on publishes this hostname to every visitor and
# opens it to anything that posts at it, so it is a decision about the
# WordPress host rather than about the build. That host must also answer
# anonymous POSTs: preprod currently serves Hostinger's "Coming Soon" page to
# logged-out visitors, and Gravity Forms never runs behind it.
# WP_FORMS_ORIGIN=https://preprod.spenza.com

# Canonical origin of the public site. Drives canonicals, Open Graph and the
# sitemap. Left at its default a preview deploy emits production canonicals, so
# set it on every non-production environment.
#
# `www`, not the apex: the certificate only covers www.spenza.com, and
# https://spenza.com fails its TLS handshake, so a canonical pointing there
# names a URL no crawler can fetch.
SITE_URL=https://www.spenza.com

# Where blog/case-study media is served from. Setting this also drops the 2.2GB
# of media out of dist/ — the bytes are served from the bucket instead.
#
# Must NOT be the WP_ORIGIN host: preprod serves "Disallow: /", so images hosted
# there would be uncrawlable — config.mjs rejects that outright.
MEDIA_ORIGIN=https://media.spenza.com

# Keep this build out of search results: robots.txt becomes "Disallow: /" and
# every response gets X-Robots-Tag: noindex.
#
# Opt-OUT on purpose. A staging site that slips into the index is embarrassing
# and fixable; a production site that ships "Disallow: /" deletes itself from
# Google and gives no signal that it happened. So indexable is the default, and
# the build warns when SITE_URL is overridden while this is unset — the shape of
# a preview deploy that forgot.
# NOINDEX=1

# Microsoft Clarity project id. Defaults to the live project, so a normal build
# is recorded; set it empty to ship a build with no analytics tag at all.
#
# The point of having it here is that this build is deployed to more than one
# place. Staging sessions in the same project as real ones quietly skew every
# heatmap and funnel, and nothing afterwards can tell them apart.
CLARITY_PROJECT_ID=y7rcw4tkeq

# Let the host serve WordPress' 301s from _redirects (or a CloudFront Function)
# and stop emitting the 86 HTML meta-refresh stand-ins. Set once the host is
# confirmed to be serving them.
# HOST_REDIRECTS=1

# Private app token for `npm run hs:check`, which compares what the site sends
# each HubSpot form against what that form actually accepts.
#
# Optional. Without it the check still verifies every form guid resolves; with
# it, it also compares field lists — which is the check that matters, because a
# collected form drops an unknown field silently and answers 200 either way.
#
# Only that one script reads it. The browser never sees it: a form submission
# goes to HubSpot's public Forms Submission API, which is authenticated by the
# form's own guid, not by a key. Never put a HubSpot key in anything under
# public/.
#
# Scope: forms. Nothing is created or modified, so no write scope is needed.
# HUBSPOT_PRIVATE_APP_TOKEN=pat-eu1-...
